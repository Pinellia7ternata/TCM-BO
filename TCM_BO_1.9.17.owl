    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003175 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003175">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003170"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>单层立方上皮（simple cuboidal epithelium）由一层近似立方形的细胞组成。从上皮表面观察，细胞呈六角形或多角形；在垂直切面上，细胞呈立方形，核圆、居中。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Simple cuboidal epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">单层立方上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003176 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003176">
