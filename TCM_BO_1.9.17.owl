    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000752">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000024"/>
