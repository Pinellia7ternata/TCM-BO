        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>悬厘穴位于人体的头部鬓发上，当头维穴与曲鬓穴弧形连线的上四分之三与下四分之一交点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">悬厘</rdfs:label>
        <rdfs:label xml:lang="zh-cn">悬厘</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000247 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000247">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>曲鬓穴位于人体的头部，当耳前鬓角发际后缘的垂线与耳尖水平线交点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">曲鬓</rdfs:label>
        <rdfs:label xml:lang="zh-cn">曲鬓</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000248 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000248">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>率谷穴位于人体的头部，当耳尖直上入发际1.5寸，角孙穴直上方。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">率谷</rdfs:label>
        <rdfs:label xml:lang="zh-cn">率谷</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000249 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000249">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>天冲穴位于人体的头部，当耳根后缘直上入发际2寸，率谷穴后0.5寸。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">天冲</rdfs:label>
        <rdfs:label xml:lang="zh-cn">天冲</rdfs:label>
    </owl:NamedIndividual>
    


