        <ns6:TCM_TO_0000035>屈肘时，当肘横纹内侧端与肱骨内上髁连线的中点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">少海</rdfs:label>
        <rdfs:label xml:lang="zh-cn">少海</rdfs:label>
