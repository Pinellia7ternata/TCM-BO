    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001708 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001708">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001705"/>
