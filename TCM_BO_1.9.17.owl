        <ns5:ICD11ID_data>XA8PQ1</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Vas deferens</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>输精管</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/260894141</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">输精管道</rdfs:label>
        <rdfs:label xml:lang="zh-cn">输精管道</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002839 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002839">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002838"/>
        <ns6:TCM_TO_0000035>附睾紧贴睾丸的上端和后缘，可分为头、体、尾三部。头部由输出小管组成，输出小管的末端连接一条附睾管。附睾管长约4-5米，构成体部和尾部。功能：为精子生长成熟提供营养：附睾管壁上皮分泌物--某些激素、酶、特异物质--为精子生长提供营养；贮存精子：精子在此贮存、发育成熟并具有活力。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA4D25</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Epididymis</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>附睾</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/413436285</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">附睾</rdfs:label>
        <rdfs:label xml:lang="zh-cn">附睾</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002840 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002840">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002838"/>
        <ns6:TCM_TO_0000035>输精管长约40厘米，呈紧硬圆索状。输精管行程较长，从阴囊到外部皮下，再通过腹股沟管入腹腔和盆腔，在膀胱底的后面精囊腺的内侧，膨大形成输精管壶腹，其末端变细，与精囊腺的排泄管合成射精管。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8PQ1</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Vas deferens</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>输精管</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/260894141</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">输精管</rdfs:label>
        <rdfs:label xml:lang="zh-cn">输精管</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002841 -->

