        <rdfs:label xml:lang="en">肩髃</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肩髃</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000072 -->

