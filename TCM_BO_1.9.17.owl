        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000028"/>
        <ns6:TCM_TO_0000035>巨髎穴位于人体的面部，瞳孔直下，平鼻翼下缘处，当鼻唇沟外侧。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">巨髎</rdfs:label>
        <rdfs:label xml:lang="zh-cn">巨髎</rdfs:label>
