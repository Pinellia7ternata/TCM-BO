        <ns5:ICD11NameZH>枕极</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1025491399</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">枕极</rdfs:label>
        <rdfs:label xml:lang="zh-cn">枕极</rdfs:label>
