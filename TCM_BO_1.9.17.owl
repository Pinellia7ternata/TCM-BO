    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000561 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000561">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001514"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of parotid lymph node</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10209003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>有两条，胸导管（左淋巴导管）和右淋巴导管。胸导管的起于乳糜池，位于第11胸椎与第2腰椎之间。乳糜池接受左、右腰干和肠干。胸导管穿经膈肌主动脉裂孔进入胸腔，再上行至颈根部，注入左静脉角，沿途接受左支气管纵隔干、左颈干和左锁骨下干。收集下半身及左上半身的淋巴。右淋巴导管短，收集右支气管纵隔干，右颈干和右锁骨下干的淋巴，注入右静脉角。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - - - - Right lymphatic duct</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>458971691</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/458971691</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - - - - 右淋巴导管</ns6:hasICD11Name>
        <ns5:ICD11ID_data>XA3ER1</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Right lymphatic duct</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>右淋巴导管</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/458971691</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">淋巴导管</rdfs:label>
        <rdfs:label xml:lang="zh-cn">淋巴导管</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10209003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000562 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000562">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000625"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Immune response: the specific activation, proliferation and effector reactions of the immune system following antigen recognition.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>免疫应答是免疫系统识别抗原后发生特异性活化、增殖与效应反应的过程。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - Immune system</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>910012423</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/910012423</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - 免疫系统</ns6:hasICD11Name>
        <rdfs:label xml:lang="en">免疫应答</rdfs:label>
        <rdfs:label xml:lang="zh-cn">免疫应答</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000563 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000563">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The cellular function of synthesizing and secreting bioactive substances such as hormones, enzymes and cytokines.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>合成生物活性物质是细胞合成并分泌激素、酶、细胞因子等生物活性物质的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">合成生物活性物质</rdfs:label>
        <rdfs:label xml:lang="zh-cn">合成生物活性物质</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000564 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000564">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Filtration: the function of structures such as the renal glomerulus or lymph nodes filtering the fluid passing through them.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>过滤作用是结构（如肾小球、淋巴结）对流经其内的液体进行滤过、分离成分的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">过滤作用</rdfs:label>
        <rdfs:label xml:lang="zh-cn">过滤作用</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000565 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000565">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of the mononuclear phagocyte system (chiefly the spleen) in removing aged and deformed erythrocytes.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>清除衰老红细胞是脾脏等单核吞噬系统识别并清除衰老、变形红细胞的功能。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - - - - Erythrocytes</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>48190539</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/48190539</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - - - - 红细胞</ns6:hasICD11Name>
        <rdfs:label xml:lang="en">清除衰老红细胞</rdfs:label>
        <rdfs:label xml:lang="zh-cn">清除衰老红细胞</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000566 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000566">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>脾主运化，是指脾具有把饮食水谷转化为水谷精微（即谷精）和津液（即水精），并把水谷精微和津液吸收、转输到全身各脏腑的生理功能。这是整个饮食物代谢过程中的中心环节，也是后天维持人体生命活动的主要生理机能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主运化</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主运化</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000567 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000567">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000570"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000566"/>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000568"/>
        <ns6:TCM_TO_0000035>运化食物，是指脾气促进食物的消化和吸收并转输其精微（谷精）的功能。食物经胃的受纳腐熟，被初步消化后，变为食糜，下送于小肠作进一步消化。食物的消化虽在胃和小肠中进行，但必须经脾气的推动、激发作用，食物才能被消化。由胃传入小肠的食糜，经脾气的作用进一步消化后，则分为清浊两部分。其精微部分，经脾气的激发作用由小肠吸收，再由脾气的转输作用输送到其他四脏，分别化为精、气、血、津液，内养五脏六腑，外养四肢百骸、皮毛筋肉。即《素问·玉机真藏论》所谓“脾为孤脏，中央土以灌四傍”；《素问·厥论》所谓“脾主为胃行其津液者也”。因此，脾气的运化功能健全，则能为化生精、气、血等提供充足的养料，脏腑、经络、四肢百骸以及筋肉皮毛等组织就能得到充足的营养而发挥正常的生理活动。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">运化食物</rdfs:label>
        <rdfs:label xml:lang="zh-cn">运化食物</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000568 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000568">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000566"/>
        <ns6:TCM_TO_0000035>运化水液，是指脾气的吸收、转输水精，调节水液代谢的功能。脾气运化水液的功能主要表现为两个方面：一是将胃和小肠消化吸收的津液，即水精，以及大肠吸收的水液，由肾气的蒸化作用回吸收的水液，经脾气的转输作用上输于肺，再由肺的宣发肃降作用输布于全身，使“水精四布，五经并行”（《素问·经脉别论》）。二是在水液的代谢过程中起枢转作用。肺为水之上源，肾为水之下源，而脾居中焦，为水液升降输布的枢纽。凡水液的上腾下达，均赖于脾气的枢转。脾气散精，将水精和部分谷精一同上输于肺，其中清纯部分经肺的宣发作用，输布于皮毛、肌腠和头面诸窍而润泽之；浓厚部分在肺的肃降作用下，下行濡润五脏六腑。输送到皮肤肌腠的津液被利用后可化汗排出体外。输送到脏腑的水精，被脏腑利用后化为浊液归肾或膀胱，经肾气的蒸化作用，浊中之清上升，经脾气之转输上达于肺，再次参与水液代谢；浊中之浊变为尿液排出体外。由于脾气在水液的升降布散运动中发挥着枢转作用，使之上行下达，畅通无阻，从而维持了水液代谢的平衡。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">运化水液</rdfs:label>
        <rdfs:label xml:lang="zh-cn">运化水液</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000569 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000569">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>脾主统血，是指脾气有统摄、控制血液在脉中正常运行而不逸出脉外的功能。明·薛己《薛氏医案》明确提出：“心主血，肝藏血，脾能统摄于血。”清·沈明宗《金匮要略编注》也说：“五脏六腑之血，全赖脾气统摄。”</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Governing blood containment (spleen)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主统血</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000570 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000570">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000591"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000593"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000594"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:SNOMEDID>118971007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Digestion and absorption: mechanical and chemical breakdown of food in the alimentary tract and uptake of the products into blood or lymph.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>消化与吸收是消化道将食物机械性与化学性分解为小分子物质并将其吸收入血或淋巴的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Digestion and absorption</rdfs:label>
        <rdfs:label xml:lang="zh-cn">消化与吸收</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118971007"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000571 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000571">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001366"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of parotid lymph node</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000049"/>
        <ns6:SNOMEDID>10209003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>弥散淋巴组织（diffuse lymphoid tissue）无固定的形态，是以网状细胞和网状纤维形成支架，网孔中分布有大量松散的淋巴细胞，与周围的结缔组织无明显分界，除含有T、B淋巴细胞外，还有浆细胞和巨噬细胞、肥大细胞等。弥散淋巴组织中有毛细血管后微静脉（postcapillary venule），其特征是内皮为单层立方或矮柱状，故又称高内皮微静脉（high endothelial venule），是淋巴细胞由血液进入淋巴组织的重要通道。当弥散淋巴组织受抗原刺激时，可出现淋巴小结。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - - - Lymphatic tissue</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>1546367254</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/1546367254</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - - - 淋巴组织</ns6:hasICD11Name>
        <ns5:ICD11ID_data>XA8SZ4</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lymphatic tissue</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>淋巴组织</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1546367254</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">弥散淋巴组织</rdfs:label>
        <rdfs:label xml:lang="zh-cn">弥散淋巴组织</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10209003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000573 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000573">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of parotid lymph node</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10209003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The lymph node function of filtering lymph to remove foreign particles, pathogens and abnormal cells.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>滤过淋巴液是淋巴结滤过流经淋巴、清除其中异物、病原体与异常细胞的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">滤过淋巴液</rdfs:label>
        <rdfs:label xml:lang="zh-cn">滤过淋巴液</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10209003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000574 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000574">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000034"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000574"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035 xml:lang="en">The whole body: a TCM locational concept denoting the entire extent of the body reached by meridians and qi-blood.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>周身是遍及全身的身体部位概念，中医学用以描述经络、气血所通达的全身范围。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">周身</rdfs:label>
        <rdfs:label xml:lang="zh-cn">周身</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000575 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000575">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000467"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000546"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>三焦通行元气于全身，是人体之气升降出入的通道，亦是气化的场所，故称三焦有主持诸气，总司全身气机和气化的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">通行元气</rdfs:label>
        <rdfs:label xml:lang="zh-cn">通行元气</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000576 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000576">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>水谷在人体运行道路及气之所终始，包括饮食物的消化、精微物质的吸收、糟粕的排泄全部过程，用“三焦者，水谷之道路”来概括。并根据上、中、下三焦所处部位不同，对水谷运行过程中所起的作用也就不同，而有上焦主纳，中焦主腐熟，下焦主分别清浊、主出的具体描述。这是以三焦运行水谷来概括饮食物的消化、吸收及排泄的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">运行水谷</rdfs:label>
        <rdfs:label xml:lang="zh-cn">运行水谷</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000580 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000580">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000584"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000585"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000586"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>大肠接受由小肠下传的食物残渣，吸收其中多余的水液，形成粪便。大肠之气的运动，将粪便传送至大肠末端，并经肛门有节制地排出体外，故大肠有“传导之官” 之称。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">传化糟粕</rdfs:label>
        <rdfs:label xml:lang="zh-cn">传化糟粕</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000581 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000581">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>大肠接受由小肠下传的含有大量水液的食物残渣，将其中的水液吸收，使之形成粪便，即所谓燥化作用。大肠吸收水液，参与体内的水液代谢，故说“大肠主津＂。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主津</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主津</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000582 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000582">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Excretion-related functions: the collective functions of eliminating metabolic end products and surplus substances via the kidneys, lungs, skin and gut.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>排泄相关功能是机体将代谢终产物与多余物质经肾、肺、皮肤、消化道等途径排出体外的功能统称。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">排泄相关功能</rdfs:label>
        <rdfs:label xml:lang="zh-cn">排泄相关功能</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000583 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000583">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000582"/>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000589"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Feces: the mixture of food residues, shed cells and metabolic wastes formed in the large intestine and discharged through the anus.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>大便是经大肠吸收水分后形成并排出的食物残渣、脱落细胞与代谢废物的混合物。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">大便</rdfs:label>
        <rdfs:label xml:lang="zh-cn">大便</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000584 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000584">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000583"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The physiological process of feces formation in the large intestine through absorption of water and electrolytes.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>形成大便是大肠吸收水分与电解质、将食糜残渣浓缩成形为粪便的生理过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">形成大便</rdfs:label>
        <rdfs:label xml:lang="zh-cn">形成大便</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000585 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000585">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000583"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of the rectum temporarily storing formed feces pending reflex evacuation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>储存大便是直肠暂时贮存已形成粪便、待反射性排出的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">储存大便</rdfs:label>
        <rdfs:label xml:lang="zh-cn">储存大便</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000586 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000586">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000583"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of controlling defecation through coordination of the internal and external anal sphincters and the defecation reflex.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>控制排便是肛门内、外括约肌与排便反射协调控制粪便适时排出的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">控制排便</rdfs:label>
        <rdfs:label xml:lang="zh-cn">控制排便</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000587 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000587">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000590"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of the bladder storing urine at low pressure during the filling phase.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>贮存尿液是膀胱在充盈期松弛以低压贮存尿液的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">贮存尿液</rdfs:label>
        <rdfs:label xml:lang="zh-cn">贮存尿液</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000588 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000588">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000518"/>
        <ns6:TCM_TO_0000035>膀胱中尿液的按时排泄，由肾气及膀胱之气的激发和固摄作用调节。肾气与膀胱之气的作用协调，则膀胱开合有度，尿液可及时地从溺窍排出体外。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">排泄尿液</rdfs:label>
        <rdfs:label xml:lang="zh-cn">排泄尿液</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000589 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000589">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000582"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Urine: the fluid formed by the kidneys, stored in the bladder and discharged through the urethra (TCM term).</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>小便是经肾生成、膀胱贮存并由尿道排出的尿液（中医术语）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">小便</rdfs:label>
        <rdfs:label xml:lang="zh-cn">小便</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000590 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000590">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000589"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Urinary storage: the bladder function of retaining urine at low pressure and preventing involuntary leakage.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>尿液贮存是膀胱低压贮存尿液、防止其不自主排出的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">尿液贮存</rdfs:label>
        <rdfs:label xml:lang="zh-cn">尿液贮存</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000591 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000591">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>小肠的受盛化物，表现于以下两个方面： 一是指小肠接受由胃腑下传的食糜而盛纳之，即受盛作用；二是指食糜在小肠内必须停留一定的时间，由脾气与小肠的共同作用对其进一步消化，化为精微和糟粕两部分，即化物作用。小肠受盛化物机能失调，表现为腹胀、腹泻、便浦等。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主受盛化物</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主受盛化物</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000592 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000592">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>泌别清浊，是指小肠中的食糜在作进一步消化的过程中，随之分为清浊两部分：清者，即水谷精微和津液，由小肠吸收，经脾气的转输作用输布全身；浊者，即食物残渣和部分水液，经胃和小肠之气的作用通过阑门传送到大肠。小肠在吸收水谷精微的同 时，还吸收了大虽的水液，与水谷精微融合为液态物质，由脾气转输到全身脏腑形体官窍。其中较清稀者上输于肺，经肺气的宣发肃降作用，布散于全身皮毛肌滕和内在脏腑，并将脏 腑代谢后产生的浊液下输肾或膀胱，以成尿液生成之源。由于小肠参与了人体的水液代谢，故有“小肠主液”之说。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主泌别清浊</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主泌别清浊</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000593 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000593">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>胃主受纳水谷，是指胃气具有接受和容纳饮食水谷的作用。饮食入口，经过食管（咽）进入胃中，在胃气的通降作用下，由胃接受和容纳，暂存于其中，故胃有 “ 太仓＂ 、“水谷 之海” 之称。机体精气血津液的化生， 都依赖千饮食物中的蓝养物质，故胃又有 “水谷气血之海” 之称。胃气的受纳水谷，既是其主腐熟的基础，也是饮食物消化吸收的基础。因此，胃气的受纳对于人体的生命活动十分重要。 胃气受纳水谷功能的强弱，可以通过食欲和饮食多少反映出来。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主受纳水谷</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主受纳水谷</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000594 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000594">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>胃主腐熟水谷，是指胃气将饮食物初步消化，并形成食糜的作用。容纳于胃中的饮食物，经过胃气的磨化和腐熟作用后，稍微物质被吸收，并由脾气转输而营养全身， 未被消化 的食糜则下传于小肠作进一步消化。
胃气的受纳、腐熟水谷功能，必须与脾气的运化功能相互配合， 纳运协调才能将水谷化 为精微， 进而化生精气血津液，供养全身。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主腐熟水谷</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主腐熟水谷</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000595 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000595">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Proximal stomach structure</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Cardia of stomach</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>116209005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The physiological function of gastric mucosal parietal and chief cells secreting hydrochloric acid, pepsinogen and mucus.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>分泌胃液是胃黏膜壁细胞、主细胞等分泌盐酸、胃蛋白酶原及黏液的生理功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>14561</ns4:FMAID>
        <rdfs:label xml:lang="en">Gastric juice secretion</rdfs:label>
        <rdfs:label xml:lang="zh-cn">分泌胃液</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#116209005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma14561"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/116209005"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000596 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000596">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000600"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>月经，又称月信、月事、月水，是女子生殖细胞发育成熟后周期性子宫出血的生理现象。健康女子，约到14岁左右，天癸至，生殖器官发育成熟，子宫发生周期性变化，约1 月(28天）左右周期性排血一次，即月经开始来潮，如《血证论·男女异同论》说：“女子胞中之血，每月换一次，除旧生新。＂约到49岁左右，天癸竭绝，月经闭止。月经周期中还要排卵一次。月经的产生，是脏腑经脉气血及天癸作用于胞宫的结果。胞宫的形态与机 能正常与否直接影响月经的来潮，所以胞宫有主持月经的作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主持月经</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主持月经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000599 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000599">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000601"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>胞宫是女性孕育胎儿的器官。女子在发育成熟后，月经应时来潮，经后便要排卵，因而有受孕生殖的能力。此时，两性交娴，两精相合，就构成了胎孕。《类经．藏象类》说： “阴阳交講，胎孕乃凝，所藏之处，名曰子宫。“ 受孕之后，月经停止来潮，脏腑经络血气 皆下注于冲任， 到达胞宫以养胎， 培育胎儿以至成熟而分挽Q 清·唐宗海《中西汇通医经 精义．下卷》说：“女子之胞，一名子宫， 乃孕子之处。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA23B0</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Fetus</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>胎儿</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/14011850</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">孕育胎儿</rdfs:label>
        <rdfs:label xml:lang="zh-cn">孕育胎儿</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000600 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000600">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489"/>
        <ns6:SNOMEDID>113231009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Cyclic endometrial changes and menstruation: the cyclic proliferation, secretion and shedding of the endometrium with bleeding under ovarian hormonal control.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>子宫内膜周期性变化及月经形成是在卵巢激素周期性调控下子宫内膜增生、分泌、脱落出血并形成月经的生理过程。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7564</ns4:FMAID>
        <rdfs:label xml:lang="en">Cyclic endometrial changes and menstruation</rdfs:label>
        <rdfs:label xml:lang="zh-cn">子宫内膜周期性变化及月经形成</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#113231009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7564"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000601 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000601">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Gestation: the uterine function of receiving the implanting zygote and providing the environment for embryonic and fetal development (the uterus governing pregnancy in TCM).</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>孕育胚胎和胎儿是子宫接纳受精卵着床并为胚胎与胎儿发育提供环境的功能（中医：胞宫主孕育）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">孕育胚胎和胎儿</rdfs:label>
        <rdfs:label xml:lang="zh-cn">孕育胚胎和胎儿</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000602 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000602">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000614"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>脑为元神之府&quot;(《本草纲目》），是生命的枢机，主宰人体的生命活动。元神来自先天，由先天之精化生，先天元气充养，故称为先天之神。人在出生之前，随形具而生之神，即为元神。如《灵枢·本神》说：两精相搏谓之神。《灵枢．经脉》说：人始生，先成精，精成而脑随生。“元神藏于脑中，为生命之主宰。元神存则生命在，元神败则生命逝。得神则生，失神则死。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主宰生命活动</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主宰生命活动</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000603 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000603">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000616"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>人的精神活动，包括思维、意识和情志活动等，都是客观外界事物反映于脑的结果。思维意识是精神活动的高级形式，是 “任物” 的结果。《灵枢·本神》说：”所以任物者谓之心。“ 心是思维的主要器官。脑为髓海，也主入的思维意识和记忆。如《类证治栽·卷三》说：＂脑为元神之府，精髓之海，实记忆所凭也。”《医林改错》说：“灵机记性不在心而在脑。” 人的思维意识，是在元神的调控下，于后天获得的思维识见活动，属识神的范畴。识 神，是思维认知之神，屈后天之神。故张锡纯《医学衷中参西录．人身神明诠》说：＂脑中为元神，心中为识神。元神者，藏于脑，无思无虑， 自然虚灵也；识神者，发于心，有思有虑，灵而不虚也。＂ 悄志活动是人对外界刺激的情绪反应，与人的情感、欲望等心身需求有 关，故属欲神范畴。因此，脑为精神活动的枢纽。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主司精神活动</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主司精神活动</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000604 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000604">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>眼、耳、口、鼻、舌等五脏外窍，皆位千头而，与脑相通。人的视、听、言、动等，皆与脑有密切关系。如《医林改错》说：“两耳通脑，所听之声归脑；两目系如线长于脑，所见之物归脑；鼻通于脑，所闻香臭归于脑；小儿周岁脑渐生，舌能言一二字。＂ 脑主元神， 神能驭气，散动觉之气于筋而达百节，令之运动，故脑能统领肢体运动。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主司感觉运动</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主司感觉运动</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Sensory functions: the collective functions of detecting internal and external stimuli through receptors and the sensory nervous system.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>感觉功能是机体通过感受器与感觉神经系统感受内外环境刺激并形成感觉的功能统称。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">感觉功能</rdfs:label>
        <rdfs:label xml:lang="zh-cn">感觉功能</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000606 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000606">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Somatic sensation: sensations arising from skin, muscles and joints, including pain, temperature, touch-pressure and proprioception.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>躯体感觉是来自皮肤、肌肉、关节等躯体结构的感觉，包括痛觉、温度觉、触压觉与本体感觉。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">躯体感觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">躯体感觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000607 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000607">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Visceral sensation: sensations arising from visceral organs, usually related to distension, ischemia or spasm.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>内脏感觉是来自内脏器官的感觉，多与内脏牵拉、缺血、痉挛等刺激相关。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">内脏感觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">内脏感觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000608 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000608">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Vision: the sensory function by which retinal photoreceptors detect light stimuli and the visual pathway conveys them to the visual cortex.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>视觉是视网膜感光细胞接受光刺激、经视路传导至视觉皮层形成视觉的感觉功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Visual system</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>视觉系统</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/358111161</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">视觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">视觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000609 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000609">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Hearing: the sensory function by which cochlear structures detect sound waves and the auditory pathway conveys them to the auditory cortex.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>听觉是耳蜗感音结构接受声波刺激、经听神经传导至听觉皮层形成听觉的感觉功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Auditory system</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>听觉系统</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/583069829</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">听觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">听觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000610 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000610">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Equilibrium sensation: the vestibular function of detecting head position and movement to maintain body balance.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>平衡感觉是前庭器官感受头部位置与运动变化、维持身体平衡的感觉功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">平衡感觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">平衡感觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000611 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000611">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Olfaction: the sensory function of olfactory receptor cells detecting odorant molecules conveyed via the olfactory nerve.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>嗅觉是嗅黏膜嗅细胞感受化学气味分子、经嗅神经传导形成嗅觉的感觉功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">嗅觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">嗅觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000612 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000612">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000605"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Gustation: the sensory function of taste buds detecting chemical stimuli conveyed via the facial and glossopharyngeal nerves.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>味觉是否与口腔味蕾感受化学刺激、经面神经与舌咽神经传导形成味觉的感觉功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">味觉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">味觉</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000613 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000613">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Regulation of somatic movement: the planning, initiation and coordination of skeletal muscle contraction by motor centers at all levels of the nervous system.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>躯体运动的调节是神经系统通过各级运动中枢对骨骼肌收缩活动进行策划、发起与协调的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">躯体运动的调节</rdfs:label>
        <rdfs:label xml:lang="zh-cn">躯体运动的调节</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000614 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000614">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Regulation of visceral activities: the control of cardiovascular, digestive and respiratory activities by the autonomic nervous system and humoral factors.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>内脏活动的调控是自主神经系统与体液因素对心血管、消化、呼吸等内脏活动的调节功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">内脏活动的调控</rdfs:label>
        <rdfs:label xml:lang="zh-cn">内脏活动的调控</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000615 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000615">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Regulation of instinctive behaviors: hypothalamic and related control of feeding, drinking and sexual behaviors.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>本能行为的调控是下丘脑等结构对摄食、饮水、性行为等本能行为的调节功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">本能行为的调控</rdfs:label>
        <rdfs:label xml:lang="zh-cn">本能行为的调控</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000616 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000616">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Regulation of emotion: limbic and related brain structures governing the generation and expression of emotions; attributed in TCM to the liver governing free flow of qi and emotions.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>情绪的调控是边缘系统等脑结构对情绪产生与表达的调节功能；中医归属肝主疏泄、调畅情志。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">情绪的调控</rdfs:label>
        <rdfs:label xml:lang="zh-cn">情绪的调控</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000617 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000617">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Sleep: a periodic, reversible state of reduced consciousness maintained by brain sleep-wake regulatory systems, serving somatic and cerebral restoration.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>睡眠是周期性出现的可逆性意识抑制状态，由脑内睡眠-觉醒调节系统维持，具有恢复体力与脑功能的作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">睡眠</rdfs:label>
        <rdfs:label xml:lang="zh-cn">睡眠</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000618 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000618">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Learning and memory: the higher nervous functions of acquiring, encoding, storing and retrieving information.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>学习与记忆是神经系统获取、编码、贮存和提取信息的高级功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">学习与记忆</rdfs:label>
        <rdfs:label xml:lang="zh-cn">学习与记忆</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000619 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000619">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Language function: the higher cortical function of language comprehension, expression, reading and writing subserved by language centers.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>语言功能是大脑皮层语言中枢实现语言理解、表达、阅读与书写的高级功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">语言功能</rdfs:label>
        <rdfs:label xml:lang="zh-cn">语言功能</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>气的推动作用，是指阳气的激发、兴奋、促进等作用。主要体现于：心激发和促进人体的生长发育及生殖机能；＠激发和促进各脏腑经络的生理机能；＠激发和促进稍血津液的生成及运行输布；＠激发和兴奋精神活动。
气的调控作用，是指阴气的减缓、抑制、宁静等作用。主要体现于：O抑制和减缓人体 的生长发育及生殖机能；＠抑制和宁静各脏腑经络的生理机能；＠抑制和减缓精血津液的生 成及运行输布；＠抑制和宁静精神活动。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">推动与调控作用</rdfs:label>
        <rdfs:label xml:lang="zh-cn">推动与调控作用</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000624 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000624">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>气的温煦作用，是指阳气的促进产热，消除寒冷，使人体温暖的作用。气的温煦作用对人体有重要的生理意义：1.温煦机体，维持相对恒定的体温；2.温煦各脏腑、经络、形体、官窍，助其进行正常的生理活动；3.温煦精血津液，助其正常施泄、循行、输布，即所谓 “得温而行，得寒而凝&quot;。气的凉润作用，是指阴气的抑制产热，消除热量，使人体寒凉的作用。气的凉润作用对人体有重要的生理意义：1.凉润机体，维持相对恒定的体温；2.凉润各脏腑、经络、形体、官窍，防其生理机能过亢；3.凉润精血津液，防其过度代谢和运行失常。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">温煦与凉润作用</rdfs:label>
        <rdfs:label xml:lang="zh-cn">温煦与凉润作用</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000625 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000625">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>气既能护卫肌表，防御外邪人侵，同时也可以祛除侵入人体内的病邪。因此，气的防御作用十分重要。
《素问·刺法论（遗篇）》说：“正气存内，邪不可千。” 说明气的防御功能正常，则邪气不易人侵。《医旨绪余．宗气营气卫气》说：“卫气者，为言护卫周身，温分肉，肥胺理， 不使外邪侵犯也。”</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">防御作用</rdfs:label>
        <rdfs:label xml:lang="zh-cn">防御作用</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000626 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000626">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>固摄作用，是指气对于体内血、津液、精等液态物质的固护、统摄和控制作用，从而防止这些物质无故流失，保证它们在体内发挥正常的生理功能。具体来说，气的固摄作用表现为：1.统摄血液，使其在脉中正常运行，防止其逸出脉外；2.固摄汗液、尿液、唾液、肾液、肠液，控制其分泌量、排泄量，使之有度而规律地排泄，防止其过多排出及无故流失；3.固摄精液，防止其妄加排泄。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">固摄作用</rdfs:label>
        <rdfs:label xml:lang="zh-cn">固摄作用</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000627 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000627">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>人体内部各个脏腑组织器官都是相对独立的，但是在它们之间充满着气这一物质。气充斥于人体各个脏腑组织器官之间，成为它们相互之间联系的中介。
人体之气的中介作用，主要是指气能感应传导信息以维系机体的整体联系。气是感应传 递信息之载体。人体内各种生命信息，都可以通过在体内升降出人运行的气来感应和传递，从而构建了人体各个部位之间的密切联系。外在信息感应和传递于内脏，内脏的各种信息反映于体表，以及内脏各种信息的相互传递，皆以人体内无形之气作为信息的载体来感应和传导。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">中介作用</rdfs:label>
        <rdfs:label xml:lang="zh-cn">中介作用</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000441 -->

    
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000629 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000629">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>血液由水谷精微所化生， 含有人体所需的丰富的营养物质。血在脉中循行，内至五脏六腑，外达皮肉筋骨，不断地对全身各腑腑组织器官起着濡养和滋润作用，以维持各脏腑组织 器官发挥生理功能，保证了人体生命活动的正常进行。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">濡养</rdfs:label>
        <rdfs:label xml:lang="zh-cn">濡养</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000630 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000630">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000631"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>神是人体生命活动的主宰及其外在总体表现的统称。神的内涵是广泛的，既是一切生理活动、心理活动的主宰，又包括了生命活动外在的体现，其中又将意识、思维、情感等精神活动归为狭义之神的范畴。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Nerve</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>神经</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/519578830</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">神</rdfs:label>
        <rdfs:label xml:lang="zh-cn">神</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000631 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000631">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>神既由精、 气、血、津液等作为物质基础而产生，又能反作用于这些物质。神具有统领、 调控这些物质在体内进行正常代谢的作用。《类经· 摄生类》说： “虽神由稍气而生，然所以统驭精气而为运用之主者， 则又在吾心之神。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Regulating the metabolism of essence, qi, blood and body fluids</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节精气血津液的代谢</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000638 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000638">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Membrane transport: the cellular function of translocating substances across the membrane by passive or active mechanisms.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>物质转运功能是细胞膜通过被动或主动方式跨膜转运物质的细胞功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">物质转运功能</rdfs:label>
        <rdfs:label xml:lang="zh-cn">物质转运功能</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000639 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000639">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Signal transduction: the process by which cells receive extracellular signals and relay them via membrane receptors and intracellular cascades to evoke biological responses.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>信号传导是细胞接受细胞外信号并经膜受体与胞内信号分子级联传递、引发生物学效应的过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">信号传导</rdfs:label>
        <rdfs:label xml:lang="zh-cn">信号传导</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000640 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000640">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Bioelectric phenomena: membrane potential changes of excitable cells arising from ionic distribution and currents, including resting and action potentials.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>生物电现象是可兴奋细胞膜两侧离子分布与流动所产生的电位变化现象，包括静息电位与动作电位。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">生物电现象</rdfs:label>
        <rdfs:label xml:lang="zh-cn">生物电现象</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000641 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000641">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Cricoid cartilage</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10062000</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Muscle cell contraction: the function of muscle cells generating shortening and tension through sliding interaction of actin and myosin filaments.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>肌细胞收缩功能是肌细胞通过肌动蛋白与肌球蛋白滑行相互作用产生缩短与张力的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9615</ns4:FMAID>
        <rdfs:label xml:lang="en">Contractile function of muscle cells</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肌细胞收缩功能</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10062000"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9615"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000716 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000716">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:TCM_TO_0000035>在侧腹部，章门下１.８寸，当第11肋骨游离端下方垂线与脐水平线的交点上。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>带脉，起于季胁，斜向下行到带脉穴，绕身一周，如腰带，能约束纵行的诸脉。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Belt vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">带脉</rdfs:label>
    </owl:Class>
    


