        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000013"/>
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000029"/>
        <ns6:TCM_TO_0000035>睛明穴位于眼部内侧，内眼角稍上方凹陷处，即目内眦角稍上方凹陷处。</ns6:TCM_TO_0000035>
