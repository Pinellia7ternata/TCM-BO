        <rdfs:label xml:lang="en">上关</rdfs:label>
        <rdfs:label xml:lang="zh-cn">上关</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000244 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000244">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>颔厌穴位于人体的头部鬓发上，当头维穴与曲鬓穴弧形连线的上四分之一与下四分之三交点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">颔厌</rdfs:label>
        <rdfs:label xml:lang="zh-cn">颔厌</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000245 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000245">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>悬颅穴位于人体的头部鬓发上，当头维穴与曲鬓穴弧形连线的中点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">悬颅</rdfs:label>
        <rdfs:label xml:lang="zh-cn">悬颅</rdfs:label>
