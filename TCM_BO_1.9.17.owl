    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000770">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000026"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000578"/>
