        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019"/>
        <ns6:TCM_TO_0000035>患者可采用仰卧的姿势，期门穴位于胸部，乳头直下，第6肋间隙，前正中线旁开4寸（与巨阙穴齐平）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">期门</rdfs:label>
        <rdfs:label xml:lang="zh-cn">期门</rdfs:label>
    </owl:NamedIndividual>
    


