                <owl:hasValue>Ear</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035 xml:lang="en">The inferior crus of the antihelix: the lower anterior ridge branching from the antihelix of the auricle.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>对耳轮下脚是对耳轮向下前方分出的隆起，为耳廓表面解剖标志之一。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA96Q7</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Crura of antihelix</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>对耳轮脚</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/131196726</ns5:ICD11Reference>
        <ns4:FMAID>52780</ns4:FMAID>
        <rdfs:label xml:lang="en">Inferior crus of antihelix</rdfs:label>
        <rdfs:label xml:lang="zh-cn">对耳轮下脚</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma52780"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003423 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003423">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000034"/>
