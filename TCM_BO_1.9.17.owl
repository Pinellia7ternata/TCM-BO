        <rdfs:label xml:lang="zh-cn">west:胸腹神经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000733 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000733">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000023"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000597"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000726"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003445"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000720"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000734"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000735"/>
        <ns6:TCM_HAO_00000000000000000421>总督一身阳经气血、主神志、调节脏腑阳气、联络腰背头项、主治神志病/腰背/头项病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于胞中，下出会阴，沿后正中线上行，经腰背、项、头，止于上唇内，行于人体后正中线上</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>督脉为“阳脉之海”，总领全身阳经，入脑络心，调节脏腑阳气与神志，主治失眠、健忘、头痛、腰痛、中风</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医脊神经、脑干部位神经、头项神经、腰背正中神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>督脉气滞、督脉阳虚、督脉瘀阻（伴腰痛、失眠）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:督脉</rdfs:label>
    </owl:NamedIndividual>
    


