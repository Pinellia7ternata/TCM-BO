    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000256 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000256">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000026"/>
        <ns6:TCM_TO_0000035>目窗穴位于人体的头部，当前发际上１.５寸，头正中线旁开２.２５寸。</ns6:TCM_TO_0000035>
        <ns4:FMAID>54448</ns4:FMAID>
        <rdfs:label xml:lang="en">Eye</rdfs:label>
        <rdfs:label xml:lang="zh-cn">目窗</rdfs:label>
