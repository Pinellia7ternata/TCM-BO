    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003168 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003168">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>上皮组织（epithelial tissue），简称上皮（epithelium），由密集排列的上皮细胞和少量的细胞间质组成。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA2013</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Hypodermis</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>皮下组织</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/586230733</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Epithelial tissue</rdfs:label>
        <rdfs:label xml:lang="zh-cn">上皮组织</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003169 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003169">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003168"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003191"/>
        <ns6:TCM_TO_0000035>被覆上皮（covering epithelium）分布广泛，除关节腔的软骨面外，身体体表和有腔器官的内表面，都衬贴着被覆上皮</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA56S9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Epithelium</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>上皮</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/461997709</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Covering epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">被覆上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003170 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003170">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003169"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003181"/>
        <ns6:TCM_TO_0000035>被覆上皮可根据上皮细胞的排列层次和细胞形态进行分类。 根据其构成细胞的层数和在垂直切面上的形状可分为两大类：单层上皮和复层上皮。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA56S9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Epithelium</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>上皮</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/461997709</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Simple epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">单层上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003171 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003171">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003170"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>单层扁平上皮（simple squamous epithelium），又称单层鳞状上皮，由一层扁平细胞组成。从上皮表面观察，细胞呈不规则形或多边形，核椭圆形，位于细胞中央；细胞边缘呈锯齿状或波浪状，互相嵌合。从垂直切面观察，细胞扁薄，胞质很少，只有含核的部分略厚。衬贴在心血管和淋巴管腔面的单层扁平上皮称内皮；分布在胸膜、腹膜和心包膜表面的单层扁平上皮称间皮 。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Simple squamous epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">单层表皮上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003172 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003172">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003171"/>
        <rdfs:subClassOf>
