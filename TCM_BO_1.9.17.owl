        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Keratinized (epidermis of skin)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">角化的：皮肤的表皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003185 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003185">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003181"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>复层立方上皮（stratified cuboidal epithelium）是由两层或数层细胞组成，表面细胞为立方形。上皮深层的细胞为立方形或多边形，附于基膜上。中间层细胞为梭形或多边形。此种上皮少见，可见于肛管和女性尿道近开口处。汗腺导管是较典型的复层立方上皮，由2-3层立方形细胞组成。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Stratified cuboidal epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">复层立方上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003186 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003186">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003185"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Crown of left upper central incisor tooth</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns4:FMAID>56555</ns4:FMAID>
        <rdfs:label xml:lang="en">Anal canal and distal female urethra</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肛管、女性尿道近开口处</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma56555"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003187 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003187">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003181"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>复层柱状上皮（stratified columnar epithelium）由数层细胞组成。表层细胞为矮柱状，胞质内含较多糖原，游离面常有分散的微绒毛。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Stratified columnar epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">复层柱状上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


