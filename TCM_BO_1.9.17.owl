    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000131">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000013"/>
        <ns6:TCM_TO_0000035>眉冲穴位于人体的头部，当攒竹穴直上入发际0.5寸，神庭穴与曲差穴连线之间。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA1LZ5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Eyebrow</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>眉</ns5:ICD11NameZH>
