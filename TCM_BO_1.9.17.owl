    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001827 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001827">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001826"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>头骨是中轴骨骼的最前端部分。除下颌骨、舌骨外，其余骨借缝或软骨牢固地结合在一起，彼此间不能活动。头骨分为脑颅和面颅。脑颅位于头方，有额骨、顶骨、蝶、枕骨等8块骨构成颅腔，容纳并保护着脑。面颅位于头的前下方，由鼻骨、颧骨、泪骨、上颌骨和下颌骨等15块骨构成口腔。并与脑颅共同构成鼻腔和眼眶。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA4RY5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Bones of the head</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>头骨</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2037389465</ns5:ICD11Reference>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Bones of the head</rdfs:label>
        <rdfs:label xml:lang="zh-cn">头骨</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


