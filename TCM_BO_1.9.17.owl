        <ns5:ICD11NameZH>气管支气管淋巴结</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1033857498</ns5:ICD11Reference>
        <ns4:FMAID>7365</ns4:FMAID>
