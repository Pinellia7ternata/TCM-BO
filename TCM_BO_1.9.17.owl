    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003436 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003436">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003407"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Ear</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035 xml:lang="en">Auricular points: reactive points distributed over the auricle corresponding to zang-fu organs, meridians and body parts, serving as the loci of auricular acupuncture.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>耳穴是分布于耳廓表面、与脏腑经络及全身各部相应的反应点，是耳针疗法的施术部位。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA01U5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Ear</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>耳</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1144556225</ns5:ICD11Reference>
        <ns4:FMAID>52780</ns4:FMAID>
        <rdfs:label xml:lang="en">Auricular point</rdfs:label>
        <rdfs:label xml:lang="zh-cn">耳穴</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110708006"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma52780"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003453 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003453">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001454"/>
        <ns6:TCM_TO_0000035>明堂：《灵枢．五色》：“明堂者，鼻也。”相当于解剖学之外鼻。别称鼽。《黄帝内经太素．经筋》：“鼻中出气之孔谓之鼻也，鼻形谓之鼽也。”明堂按部位不同，有山根鼻尖鼻梁鼻翼鼻孔之分。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">明堂</rdfs:label>
        <rdfs:label xml:lang="zh-cn">明堂</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003454 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003454">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003453"/>
        <ns6:TCM_TO_0000035>解剖学之鼻根。位于两目内眦间的低凹部，属鼻梁的上端。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">山根</rdfs:label>
        <rdfs:label xml:lang="zh-cn">山根</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003455 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003455">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001454"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Hair of left lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>当于解剖学之鼻腔，包括固有鼻腔和鼻前庭两部分。《明医指掌》：“鼻窍应知与肺通。”鼻窍位于明堂之内，中空，属清道。鼻窍按部位结构不同，可分为鼻前庭鼻腔鼻隔中血堂鼻道畜门。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA3H13</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Nose</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1082634473</ns5:ICD11Reference>
        <ns4:FMAID>54247</ns4:FMAID>
        <rdfs:label xml:lang="en">Nasal orifice</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻窍</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54247"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003456 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003456">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003455"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Hair of left lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>解剖学之鼻中隔。《医学入门》卷４：“有痰火冲肺者，鼻隔隐痛。”</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8D47</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Nasal septum</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻中隔</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/185288147</ns5:ICD11Reference>
        <ns4:FMAID>54247</ns4:FMAID>
        <rdfs:label xml:lang="en">Nasal septum</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻隔</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54247"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003457 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003457">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003455"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>相当于鼻中隔前下方之李特氏区。《医宗金鉴．正骨心法要旨》：“中血堂，即鼻内頞下脆骨空虚之处也。若被打扑损伤，血流不止，神气昏迷......”。《中医大辞典．外科骨伤五官分册》：“似指鼻中隔前部李特氏（little`s）区。”</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Zhongxuetang (term to be verified)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">中血堂</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003458 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003458">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003455"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Hair of left lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>同解剖学。《普济方．身形》：“邪正相搏，鼻道不通。”又称鼻隧。《灵枢．师传》：“鼻隧以长，以候大肠。”《简明中医辞典》：“鼻孔深处称为鼻隧”，“鼻隧，鼻孔深处之通道。”又称鼻管。《东垣试效方》：“......使阳气宗气上升，则鼻管通矣。”</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA3H13</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Nose</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1082634473</ns5:ICD11Reference>
        <ns4:FMAID>54247</ns4:FMAID>
        <rdfs:label xml:lang="en">Nasal meatus</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻道</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#113179006"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54247"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003459 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003459">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003455"/>
        <ns6:TCM_TO_0000035>解剖学之后鼻孔。《灵枢．营气》：“营气之道......从肝上注肺，上循喉咙，入颃之窍，究于畜门。”《类经》注：“畜门，即喉屋上通鼻之窍门也。如《评热病论》：启玄子有云，气冲突于畜门而出于鼻，即此谓也。”亦指前鼻孔。如杨上善《黄帝内经太素》：“畜门，鼻孔也。”张志聪注：“畜门，鼻之外窍。”</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">畜门</rdfs:label>
        <rdfs:label xml:lang="zh-cn">畜门</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003460 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003460">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001847"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>《医宗金鉴．正骨心法要旨》：“鼻孔之介骨，名曰鼻梁骨。”指构成鼻梁的骨和软骨支架，包括解剖学之鼻骨隔背软骨，以及鼻中隔软骨。又称为梁骨。《证治准绳．疡医》：“鼻之前为梁骨。”</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8E16</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Nasal bone</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻骨</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/224708056</ns5:ICD11Reference>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Nasal bone</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻梁骨</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003461 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003461">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001847"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>《证治准绳．疡医》：“（鼻）梁之端为嵩柱骨。”相当于构成鼻准的大翼软骨。</ns6:TCM_TO_0000035>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Songzhu bone (term to be verified)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">嵩柱骨</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003462 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003462">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001847"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>《简明中医辞典》：“鼻柱骨，两鼻孔间之软骨。”即鼻中隔软骨。是鼻梁骨的一部分。又称为天柱骨。《笔花医镜》卷２：“肾之寒，肾之虚也......其症为天柱骨倒。”</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8E16</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Nasal bone</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻骨</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/224708056</ns5:ICD11Reference>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Nasal bone</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻柱骨</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003463 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003463">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001847"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>指上颌骨。《医宗金鉴．正骨心法要旨》：“目巢......其下曰出骨骨，出骨骨下接上牙床。”上颌窦位于出骨骨之内。</ns6:TCM_TO_0000035>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Chuye bone (term to be verified)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">出页骨</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003464 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003464">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001847"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>指上颌骨。《医宗金鉴．正骨心法要旨》：“目巢......其下曰出骨骨，出骨骨下接上牙床。”上颌窦位于出骨骨之内。</ns6:TCM_TO_0000035>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Superciliary arch</rdfs:label>
        <rdfs:label xml:lang="zh-cn">眉棱骨</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#105582001"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003468 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003468">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003401"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Zang-fu organs: the TCM collective term for the five zang organs, six fu organs and extraordinary fu organs, constituting the core structures of vital activities.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>脏腑是中医学对五脏、六腑与奇恒之腑的统称，是人体生命活动的核心结构。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">脏腑</rdfs:label>
        <rdfs:label xml:lang="zh-cn">脏腑</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003469 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003469">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003468"/>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003474"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The five zang organs—heart, liver, spleen, lung and kidney—whose common physiological feature is producing and storing essence-qi: storing without discharging.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>五脏是心、肝、脾、肺、肾的合称，其共同的生理特点是化生和贮藏精气，藏而不泻，满而不能实。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Five zang organs</rdfs:label>
        <rdfs:label xml:lang="zh-cn">五脏</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003472 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003472">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003468"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The six fu organs—gallbladder, stomach, small intestine, large intestine, bladder and sanjiao—whose common physiological feature is receiving, transporting and transforming food and fluids: discharging without storing.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>六腑是胆、胃、小肠、大肠、膀胱、三焦的合称，其共同的生理特点是受盛和传化水谷，泻而不藏，实而不能满。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Six fu organs</rdfs:label>
        <rdfs:label xml:lang="zh-cn">六腑</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003474 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003474">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003468"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The extraordinary fu organs—brain, marrow, bone, vessels, gallbladder and uterus—hollow in form like fu organs but storing essence like zang organs, hence termed extraordinary.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>奇恒之府是脑、髓、骨、脉、胆、女子胞的合称，其形态中空似腑而功能贮藏精气似脏，故名奇恒。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Extraordinary fu organs</rdfs:label>
        <rdfs:label xml:lang="zh-cn">奇恒之府</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003903 -->

