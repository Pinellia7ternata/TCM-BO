        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000023"/>
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000026"/>
        <ns6:TCM_TO_0000035>风府穴位于后颈部，两风池穴连线中点，颈顶窝处。当后发际正中直上1寸，枕外隆凸直下，两侧斜方肌之间凹陷处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">风府</rdfs:label>
        <rdfs:label xml:lang="zh-cn">风府</rdfs:label>
    </owl:NamedIndividual>
    


