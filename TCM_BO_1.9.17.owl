        <rdfs:label xml:lang="en">Jimai (LR12 acupoint)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">急脉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000344 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000344">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019"/>
        <ns6:TCM_TO_0000035>章门穴位于人体的侧腹部，当第11肋游离端的下方。</ns6:TCM_TO_0000035>
