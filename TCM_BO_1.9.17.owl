        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019"/>
        <rdfs:label xml:lang="en">中都</rdfs:label>
        <rdfs:label xml:lang="zh-cn">中都</rdfs:label>
    </owl:NamedIndividual>
    


