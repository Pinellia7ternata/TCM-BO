        </rdfs:subClassOf>
        <ns4:FMAID>7088</ns4:FMAID>
        <rdfs:label xml:lang="en">Endothelium (heart, blood vessels, lymphatic vessels)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">内皮：心、血管、淋巴管</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7088"/>
    </owl:Class>
    


