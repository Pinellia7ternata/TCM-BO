    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001463 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001463">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001454"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003193"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Hair of left lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>同解剖学。四版教材《中医耳鼻咽喉科学》：“邪热循经上蒸，灼伤鼻窦而为病。”古代中医文献无鼻窦的名称和概念，对常见的鼻窦疾病─鼻渊（化脓性鼻窦炎），一些古代医家并不认为在“鼻”，而认为在“脑”，故鼻渊又有称为脑崩脑漏沥脑脑泻等。这种概念的“脑”即指鼻窦。鼻窦亦称窦窍。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA3523</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Accessory sinuses</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻窦</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2037717603</ns5:ICD11Reference>
        <ns4:FMAID>54247</ns4:FMAID>
        <rdfs:label xml:lang="en">Accessory sinuses</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻窦</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54247"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001468 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001468">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001453"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001516"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Left third upper molar tooth</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>指口腔、鼻腔之后，食管以上的空腔处。是饮食和呼吸的共同通道。自口腔到食管和喉的通道。由肌肉和黏膜构成。食物从嘴进入食管的通道，空气也从鼻腔经咽部入喉、气管。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA93V5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Pharynx</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>咽</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/899820155</ns5:ICD11Reference>
        <ns4:FMAID>55701</ns4:FMAID>
        <rdfs:label xml:lang="en">Pharynx</rdfs:label>
        <rdfs:label xml:lang="zh-cn">咽</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma55701"/>
    </owl:Class>
    


