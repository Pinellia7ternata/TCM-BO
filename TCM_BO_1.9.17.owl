    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000698 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000698">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000662"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001478"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Ear</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>在耳道传送的声波会到达耳膜或鼓膜。这些机械波讯息通过一系列的骨头—锤骨(锤)、砧骨(砧)和镫骨(镫)在充满空气的中耳腔传送。这些小骨扮演着杠杆和电报交换器的角色，把低压微弱的机械波转换成高压强烈的机械波在另一个，更小的薄膜叫卵圆窗。更高的压力是必要的，因为在卵圆窗之外的内耳包含的是分泌液而不是空气。经过听骨链的声音并非平均地被放大。中耳肌肉的听觉反射帮助保护内耳免受损伤。中耳仍然以机械波形式包含声音资讯，然后声音资讯会在耳蜗被转换成神经冲动。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0G74</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Middle Ear</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>中耳</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1902897114</ns5:ICD11Reference>
        <ns4:FMAID>52780</ns4:FMAID>
        <rdfs:label xml:lang="en">Middle Ear</rdfs:label>
        <rdfs:label xml:lang="zh-cn">中耳</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma52780"/>
    </owl:Class>
    


