    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000250">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>浮白穴位于人体的头部，当耳后乳突的后上方，天冲穴与完骨穴的弧形连线的中三分之一与上三分之一交点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">浮白</rdfs:label>
        <rdfs:label xml:lang="zh-cn">浮白</rdfs:label>
    </owl:NamedIndividual>
    


