    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000302 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000302">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000296"/>
