        <rdfs:label xml:lang="zh-cn">阳白</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000255 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000255">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000026"/>
        <ns6:TCM_TO_0000035>头临泣穴位于人体的头部，当瞳孔直上入前发际0.5寸，神庭穴与头维穴连线的中点处。</ns6:TCM_TO_0000035>
        <ns4:FMAID>54908</ns4:FMAID>
        <rdfs:label xml:lang="en">Toulinqi (GB15 acupoint)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">头临泣</rdfs:label>
