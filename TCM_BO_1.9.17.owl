        <ns5:ICD11NameEN>Haematopoietic stem cells</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>造血干细胞</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1207618189</ns5:ICD11Reference>
