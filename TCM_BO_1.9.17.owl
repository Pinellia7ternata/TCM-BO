    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002345"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000025"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000742"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000818"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000740"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000742"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000794"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003404"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741"/>
        <ns6:TCM_HAO_00000000000000000658>附着于骨骼表面，遍布全身，四肢肌发达，躯干肌构成胸壁/腹壁</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>通过收缩舒张实现肢体运动、维持机体姿势、产生热量维持体温、保护骨骼与关节</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>骨骼肌纤维、肌内膜、肌束膜、肌外膜，结缔组织、血管与运动神经</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>骨骼肌（横纹肌）、快肌纤维、慢肌纤维；按功能分屈肌、伸肌、展肌、收肌</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>肌萎缩、肌炎、横纹肌溶解、肌肉拉伤、重症肌无力</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>肌酸激酶（CK）、肌肉力量、肌容积</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>运动系统</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label>Muscle</rdfs:label>
        <rdfs:label xml:lang="zh-cn">west:肌肉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000740 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000740">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000510"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000025"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000784"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000785"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000800"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000799"/>
        <ns6:TCM_HAO_00000000000000000658>连接中枢神经系统（脑、脊髓）与躯体各器官/组织，遍布全身，分为脑神经（12对）、脊神经（31对）</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000772>神经纤维（轴突、髓鞘）、神经束膜、神经外膜、血管与神经胶质细胞，髓鞘负责绝缘与加速信号传导</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>脑神经、脊神经；按功能分感觉神经、运动神经、混合神经</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>周围神经炎、坐骨神经痛、三叉神经痛、糖尿病周围神经病变、神经损伤</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>神经传导速度（NCV）、肌电图</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>传导躯体感觉（痛、温、触、压）与运动指令、支配内脏器官活动、参与外周反射</ns6:TCM_HAO_00000000000000000776>
        <ns6:TCM_HAO_00000000000000000776>神经系统（周围部分）</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label>Peripheral Nerve</rdfs:label>
        <rdfs:label xml:lang="zh-cn">west:周围神经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002784"/>
        <rdfs:label xml:lang="zh-cn">west:运动系统</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000742 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000742">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001825"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000025"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000818"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000743"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000818"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000598"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741"/>
        <ns6:TCM_HAO_00000000000000000658>遍布全身，构成人体骨架，分颅骨、躯干骨、四肢骨，颅骨保护脑，胸廓保护心肺</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>支撑机体形态、保护内脏器官、参与肢体运动、储存钙磷等矿物质、为骨髓提供解剖载体、参与造血（红骨髓）</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>骨密质、骨松质、骨膜、骨髓，含成骨细胞、破骨细胞、骨细胞，胶原纤维与钙盐沉积</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>长骨（肱骨、股骨）、短骨（腕骨、跗骨）、扁骨（颅骨、胸骨）、不规则骨（椎骨、髋骨）</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>骨质疏松、骨折、骨肿瘤、骨髓炎、佝偻病、骨关节炎</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>骨密度（BMD）、血钙2.25-2.75mmol/L、血磷0.96-1.62mmol/L</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>运动系统（核心组成）</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label>Bone</rdfs:label>
        <rdfs:label xml:lang="zh-cn">west:骨</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000743 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000743">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000057"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000742"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000796"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000671"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000742"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000794"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000795"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003475"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000736"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000744"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000782"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000783"/>
        <ns6:TCM_HAO_00000000000000000658>填充于长骨骨髓腔、扁平骨/不规则骨的松质骨间隙内，红骨髓分布于婴幼儿全身骨骼、成人扁骨/长骨两端</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>生成红细胞/白细胞/血小板（造血功能）、培育免疫细胞（T/B细胞前体）、构成造血微环境支持干细胞增殖分化、黄骨髓可转化为红骨髓参与应急造血</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>造血组织（造血干细胞、定向祖细胞、造血基质细胞）、基质组织（结缔组织、血管、神经、血窦）、黄骨髓以脂肪组织为主</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>按功能分红骨髓（造血活跃）、黄骨髓（造血静止，脂肪化）；按分布分中心性骨髓、外周性骨髓</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>白血病、再生障碍性贫血、骨髓增生异常综合征、多发性骨髓瘤、骨髓纤维化</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>骨髓增生程度、造血干细胞比例、外周血血细胞计数</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>造血系统（核心器官）、运动系统（骨的组成部分）、免疫系统（中枢免疫器官）</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label xml:lang="zh-cn">west:骨髓</rdfs:label>
    </owl:NamedIndividual>
    


