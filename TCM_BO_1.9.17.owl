                <owl:hasValue>Vasculature of esophagus</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10517005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>小脑扁桃体位于小脑半球下方一对明显的隆起，叫小脑扁桃体。此扁桃体正位于枕骨大孔上方，脑压增高或附近发生肿瘤时可将其挤压入枕骨大孔外，即为枕骨大孔小脑扁桃体疝，发生此疝可有生命危险。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA7E38</ns5:ICD11ID_data>
