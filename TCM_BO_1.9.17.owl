        <ns6:hasICD11Name>- - - - 细胞壁</ns6:hasICD11Name>
        <rdfs:label xml:lang="en">网状细胞</rdfs:label>
        <rdfs:label xml:lang="zh-cn">网状细胞</rdfs:label>
    </owl:Class>
    


