        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017"/>
        <ns6:TCM_TO_0000035>三阴交穴位于小腿内侧，当足内踝尖上3寸，胫骨内侧缘后方（足内踝上缘四指宽，在踝尖正上方胫骨边缘凹陷中）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">三阴交</rdfs:label>
        <rdfs:label xml:lang="zh-cn">三阴交</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000290 -->

