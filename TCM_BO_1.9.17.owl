            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>被覆上皮可根据上皮细胞的排列层次和细胞形态进行分类。 根据其构成细胞的层数和在垂直切面上的形状可分为两大类：单层上皮和复层上皮。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA56S9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Epithelium</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>上皮</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/461997709</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Stratified epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">复层上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003182 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003182">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003181"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>复层扁平上皮（stratified squamous epithelium）由多层细胞组成，因表层细胞是扁平鳞片状，又称复层鳞状上皮。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Stratified squamous epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">复层扁平上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


