            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Eye</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11287007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>眼睑位于眼球前方，分上、下眼睑，眼睑间的裂缝称睑裂。眼睑由皮肤、结缔组织、肌肉、腺和结膜组成，是保护眼球的重要结构。眼睑的游离缘称睑缘，是皮肤和粘膜的交界，有2～3列睫毛，并有腺的开口。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA3RB1</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Eyelids</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>眼睑</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1142633691</ns5:ICD11Reference>
        <ns4:FMAID>54448</ns4:FMAID>
        <rdfs:label xml:lang="en">Eyelids</rdfs:label>
        <rdfs:label xml:lang="zh-cn">眼睑</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11287007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54448"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/11287007"/>
    </owl:Class>
    


