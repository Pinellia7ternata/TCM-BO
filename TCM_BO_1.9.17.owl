        <rdfs:label xml:lang="zh-cn">部位</rdfs:label>
    
        <ns6:TCM_TO_0000036 xml:lang="zh-cn">部位</ns6:TCM_TO_0000036>
        <ns6:TCM_TO_0000036 xml:lang="en">部位</ns6:TCM_TO_0000036>
        <rdfs:comment xml:lang="zh-cn">1.9.15 经三专家复核与PI裁决，由 TCM_HAO_0003418（部位）合并入本类，公理与映射注解已迁移。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000662"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Body region: a general term for a topographic division of the body surface or interior, used to describe the location and extent of structures.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>部位是人体体表或内部区域划分的通称，用于描述结构的位置与范围。</ns6:TCM_TO_0000035></owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000037 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000037">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000452"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001827"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medullary tributary of fourth posterior intercostal vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>105582001</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>颅骨（skull）位于脊柱上方，由23块形状和大小不同的扁骨和不规则骨组成（中耳的3对听小骨未计入）。除下颌骨及舌骨外，其余各骨彼此借缝或软骨牢固连结，起着保护和支持脑、感觉器官以及消化器和呼吸器的起始部分的作用。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA1RZ4</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Cranial Bones</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>颅骨</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/703099594</ns5:ICD11Reference>
        <ns4:FMAID>12598</ns4:FMAID>
        <rdfs:label xml:lang="en">Cranial Bones</rdfs:label>
        <rdfs:label xml:lang="zh-cn">颅骨</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#105582001"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma12598"/>
    </owl:Class>
    


