        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019"/>
        <ns6:TCM_TO_0000035>行间穴位于足背侧，当第1、2趾间，趾蹼缘的后方赤白肉际处（足背侧，大拇趾、二趾合缝后方赤白肉分界处凹陷中，稍微靠大拇趾边缘）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">行间</rdfs:label>
        <rdfs:label xml:lang="zh-cn">行间</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000334 -->

