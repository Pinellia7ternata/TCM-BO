    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001499 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001499">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001452"/>
        <ns6:TCM_TO_0000035>下呼吸道（low respiratory tract），是指临床上气管、主支气管及肺内的各级支气管。在吸气时，空气通过鼻子或者口腔进入气管，而气管则进而分叉形成两个支气管，并且进入胸腔内的肺组织中。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA07R2</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lower respiratory tract</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>下呼吸道</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/909890232</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">Lower respiratory tract</rdfs:label>
        <rdfs:label xml:lang="zh-cn">下呼吸道</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118969007"/>
    </owl:Class>
    


