        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000736"/>
        <ns6:TCM_HAO_00000000000000000658>遍布全身淋巴管网，集中分布于颈部、腋窝、腹股沟、纵隔、腹腔，呈圆形或椭圆形</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>滤过淋巴液（清除病原体、异物、衰老细胞）、培育免疫细胞（T/B细胞）、参与免疫应答（特异性免疫）、引流淋巴液</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>淋巴组织（淋巴细胞、巨噬细胞）、淋巴窦、结缔组织被膜、血管与神经，分为皮质与髓质</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>按部位分颈部淋巴结、腋窝淋巴结、腹股沟淋巴结等；结构上分皮质、髓质、淋巴窦</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>淋巴结肿大、淋巴结炎、淋巴瘤、淋巴转移癌、淋巴结结核</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>淋巴结大小（正常＜1cm）、淋巴细胞计数</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>免疫系统、淋巴系统（核心组成）</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label xml:lang="zh-cn">west:淋巴结</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000793 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000793">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000066"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000667"/>
