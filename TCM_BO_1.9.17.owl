        <ns6:TCM_TO_0000035>劳宫穴位于人体的手掌心，当第２、３掌骨之间偏于第３掌骨，握拳屈指的中指尖处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">劳宫</rdfs:label>
        <rdfs:label xml:lang="zh-cn">劳宫</rdfs:label>
    </owl:NamedIndividual>
    


