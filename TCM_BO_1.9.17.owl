        <ns6:TCM_TO_0000035>天鼎穴位于人体的颈外侧部，胸锁乳突肌后缘，当结喉旁，扶突穴与缺盆穴连线中点。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">天鼎</rdfs:label>
        <rdfs:label xml:lang="zh-cn">天鼎</rdfs:label>
    </owl:NamedIndividual>
    


