        <ns6:TCM_TO_0000035>强间穴位于人体的头部，当后发际正中直上4寸(脑户穴上1.5寸) 。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">强间</rdfs:label>
        <rdfs:label xml:lang="zh-cn">强间</rdfs:label>
