        <rdfs:label xml:lang="zh-cn">未角化的：口腔、食管、阴道等</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma56555"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003184 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003184">
