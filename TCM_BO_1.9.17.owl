    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003173">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003171"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Heart</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns4:FMAID>7088</ns4:FMAID>
        <rdfs:label xml:lang="en">Mesothelium (pleura, peritoneum, pericardium)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">间皮：胸膜、腹膜、心包膜</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7088"/>
