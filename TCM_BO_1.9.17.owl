        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000577"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Mu-kuang: the TCM term for the orbit and its surrounding structures enclosing the eyeball.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>目眶是中医学对眼眶及其周围结构的称谓，为眼球所处的骨性围护结构。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA2WJ9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Orbit</ns5:ICD11NameEN>
