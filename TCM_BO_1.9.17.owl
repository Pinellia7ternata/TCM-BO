    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001370 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001370">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001369"/>
