    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002845 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002845">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002843"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003269"/>
        <ns6:TCM_TO_0000035>呈栗子形，位于膀胱底和尿生殖膈之间，分底、体、尖。体后面有一纵生浅沟为前列腺沟，内部有尿道穿过。功能：分泌一种含的较多草酸盐和酸性磷酸酶的乳状碱性液体，称为前列腺液。其作用是可以中和射精后精子遇到的酸性液体，从而保证精子的活动和受精能力。前列腺液是精浆的重要组成成份，约占精浆的20%。前列腺还可以分泌激素，称之为前列腺素，具有运送精子、卵子和影响子宫运动等功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA63E5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Prostate gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>前列腺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1784009725</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">前列腺</rdfs:label>
        <rdfs:label xml:lang="zh-cn">前列腺</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002846 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002846">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002843"/>
        <ns6:TCM_TO_0000035>是埋藏在尿生殖膈内，豌豆形，开口于尿道海绵体部的起始部。功能：分泌蛋清样碱性液体，排入尿道球部，参与精液组成。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA3KB3</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Paraurethral gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>尿道旁腺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1856577253</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">尿道球腺</rdfs:label>
        <rdfs:label xml:lang="zh-cn">尿道球腺</rdfs:label>
    </owl:Class>
    


