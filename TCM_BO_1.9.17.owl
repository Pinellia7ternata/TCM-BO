    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000778 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000778">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002787"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000683"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000796"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000683"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000784"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000794"/>
