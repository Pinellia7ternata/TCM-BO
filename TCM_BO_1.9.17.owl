    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000784 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000784">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000245"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000785"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000826"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000740"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000785"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000597"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000797"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000798"/>
        <ns6:TCM_HAO_00000000000000000658>颅腔内，被颅骨保护，分为大脑半球、间脑、脑干、小脑，上邻硬脑膜，下接脊髓</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>调节全身生理活动、主导精神意识、思维、记忆、感知（视觉/听觉/触觉）、调控躯体运动与内脏功能、参与语言与情感表达</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>神经组织（神经元、神经胶质细胞）、结缔组织、血管与脑脊液，大脑皮层为灰质、深部为白质</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>大脑半球（额叶、顶叶、颞叶、枕叶）、间脑、脑干（中脑、脑桥、延髓）、小脑</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>脑梗死、脑出血、脑肿瘤、阿尔茨海默病、癫痫、脑膜炎</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>脑血流速度、脑电图（EEG）、脑脊液压力（80-180mmH₂O）</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>神经系统（中枢核心）</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label xml:lang="zh-cn">west:脑</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000785 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000785">
