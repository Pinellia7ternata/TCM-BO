    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002896 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002896">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002895"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Crown of left upper central incisor tooth</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>位于阴蒂与阴道口之间，为一不规则的椭圆形小孔。尿道口后壁两旁有一对腺体，称尿道旁腺，常为细菌潜伏之处。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8KN5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Internal urethral orifice</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>尿道内口</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2059975565</ns5:ICD11Reference>
        <ns4:FMAID>56555</ns4:FMAID>
        <rdfs:label xml:lang="en">Internal urethral orifice</rdfs:label>
        <rdfs:label xml:lang="zh-cn">尿道口</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma56555"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002897 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002897">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002895"/>
        <ns6:TCM_TO_0000035>位于大阴唇后部，是阴道口两侧的腺体。大似黄豆；腺管细长l～2cm，开口于小阴唇与处女膜之间的沟内。性兴奋时分泌黄白色黏液起润滑作用。正常情况检查时不能触及此腺。若因感染腺管口闭塞，形成脓肿或囊肿，则能看到或触及。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">前庭大腺（巴氏腺）</rdfs:label>
        <rdfs:label xml:lang="zh-cn">前庭大腺（巴氏腺）</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002898 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002898">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002895"/>
        <ns6:TCM_TO_0000035>位于前唇两侧由具有勃起性的静脉丛组成，表面覆盖有球海绵体肌。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA2E07</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Bulbospongiosus muscle</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>球海绵体肌</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/213309887</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">前庭球（海绵体）</rdfs:label>
        <rdfs:label xml:lang="zh-cn">前庭球（海绵体）</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002899 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002899">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002888"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002891"/>
