    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000694 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000694">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002785"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000697"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000683"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000695"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000779"/>
        <ns6:TCM_HAO_00000000000000000658>由肾、输尿管、膀胱、尿道组成，分布于腹后壁、盆腔内</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>排泄代谢废物、调节水盐/酸碱平衡、维持内环境稳定、生成并排出尿液</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>上皮组织（尿路）、肌组织（膀胱/输尿管）、结缔组织、血管神经</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>泌尿系统（人体九大系统之一），分上尿路（肾、输尿管）、下尿路（膀胱、尿道）</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>泌尿系统感染、尿路结石、肾功能衰竭、膀胱癌</ns6:TCM_HAO_00000000000000000774>
        <rdfs:label xml:lang="zh-cn">west:泌尿系统</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000695 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000695">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002820"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000779"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000789"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000791"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000683"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000740"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000779"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000579"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000694"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000829"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000830"/>
        <ns6:TCM_HAO_00000000000000000658>盆腔内，耻骨联合后方，男性邻前列腺，女性邻子宫与阴道</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>储存尿液、通过逼尿肌收缩排出尿液、调节膀胱内压、尿道内口括约肌控制排尿</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>平滑肌层（逼尿肌）、移行上皮、结缔组织被膜、尿道内口括约肌</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>膀胱尖、膀胱体、膀胱底、膀胱颈</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>膀胱炎、膀胱结石、膀胱癌、尿失禁、膀胱过度活动症</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>膀胱容量300-500ml、残余尿量＜10ml</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>泌尿系统</ns6:TCM_HAO_00000000000000000776>
        <rdfs:label>Bladder</rdfs:label>
        <rdfs:label xml:lang="zh-cn">west:膀胱</rdfs:label>
    </owl:NamedIndividual>
    


