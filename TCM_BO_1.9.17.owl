        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_TO_0000035>听会穴位于人体的面部，当耳屏间切迹的前方，下颌骨髁突的后缘，张口有凹陷处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">听会</rdfs:label>
        <rdfs:label xml:lang="zh-cn">听会</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000243 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000243">
