    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000313">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000230"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Posterior surface of ninth costal cartilage</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>120638006</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>脊髓，呈前后稍扁的圆柱体，全长粗细不等，位于椎管内，上端在枕骨大孔处与延髓相连，下端尖削呈圆锥状，称脊髓圆锥，圆锥尖端延续为一细丝，称终丝，终丝向下经骶管终于第2尾椎的背面，成人脊髓全长约42～45厘米。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0V83</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Spinal cord</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>脊髓</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1150229943</ns5:ICD11Reference>
        <ns4:FMAID>8361</ns4:FMAID>
        <rdfs:label xml:lang="en">Spinal cord</rdfs:label>
        <rdfs:label xml:lang="zh-cn">脊髓</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#120638006"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma8361"/>
