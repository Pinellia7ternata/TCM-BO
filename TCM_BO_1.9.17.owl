        <ns5:ICD11NameZH>面淋巴管</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2139888048</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">淋巴管（）</rdfs:label>
        <rdfs:label xml:lang="zh-cn">淋巴管（）</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10209003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000560 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000560">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001514"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of parotid lymph node</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10209003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>由淋巴管汇合形成，全身淋巴干共有9条：即左、右颈干，左、右锁骨下干，左、右支气管纵隔干，左、右腰干以及肠干。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - - - - Intestinal lymphatic trunk</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>440775758</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/440775758</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - - - - 肠淋巴干</ns6:hasICD11Name>
