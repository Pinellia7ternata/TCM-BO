    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000228 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000228">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000226"/>
