        <ns6:TCM_TO_0000035>阴廉穴位于人体的大腿内侧，当气冲穴直下2寸，大腿根部，耻骨结节的下方，长收肌的外缘。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">阴廉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">阴廉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000343 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000343">
