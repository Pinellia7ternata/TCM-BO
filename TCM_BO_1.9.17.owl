    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000307 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000307">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000305"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000350"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000558"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of cornea of left eye</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Eye</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11287007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>起自中脑的动眼神经核，含有躯体运动和内脏运动两种纤维。躯体运动纤维支配眼球的下直肌、内直肌、下斜肌、上直肌和上睑提肌的运动。内脏运动纤维（副交感纤维）支配瞳孔括约肌和睫状肌，使瞳孔缩小，晶状体变凸。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA7488</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Oculomotor nerve</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>动眼神经</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1865403968</ns5:ICD11Reference>
        <ns4:FMAID>54448</ns4:FMAID>
        <rdfs:label xml:lang="en">Oculomotor nerve</rdfs:label>
        <rdfs:label xml:lang="zh-cn">动眼神经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11287007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54448"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/11287007"/>
    </owl:Class>
    


