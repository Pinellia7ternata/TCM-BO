        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017"/>
        <ns6:TCM_TO_0000035>地机穴位于人体的小腿内侧，当内踝尖与阴陵泉穴的连线上，阴陵泉穴下3寸。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">地机</rdfs:label>
        <rdfs:label xml:lang="zh-cn">地机</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000292 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000292">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017"/>
        <ns6:TCM_TO_0000035>阴陵泉穴位于小腿内侧，膝下胫骨内侧凹陷中，与阳陵泉相对（或当胫骨内侧髁后下方凹陷处）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">阴陵泉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">阴陵泉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000293 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000293">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017"/>
        <ns6:TCM_TO_0000035>&quot;血海穴位于大腿内侧，髌底内侧端上2寸，当股四头肌内侧头的隆起处（从膝盖骨内侧的上角，上面约三指宽筋肉的沟，一按就感觉到痛的地方）。
简易取穴法：患者屈膝，医者以左手掌心按于患者右膝髌骨上缘，二至五指向上伸直，拇指约呈45度斜置，拇指尖下是穴。&quot;</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Xuehai (SP10 acupoint)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">血海</rdfs:label>
    </owl:NamedIndividual>
    


