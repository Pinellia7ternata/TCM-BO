    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000657 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000657">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003472"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000680"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003445"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_900000000000000000068"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000697"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000698"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000699"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000700"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000694"/>
        <ns6:TCM_HAO_00000000000000000421>主通行元气、通调水道、运行水谷精微，分为上焦、中焦、下焦</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>遍及全身，上焦对应心肺、中焦对应脾胃、下焦对应肝肾膀胱大肠，决渎之官所在，无固定形态</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>三焦是六腑中唯一无固定形态的脏腑，通行元气指元气借三焦布散于全身；通调水道指三焦维系全身水液的代谢与运行；上焦如雾、中焦如沤、下焦如渎，分别对应不同的生理功能</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医全身的循环系统、泌尿系统、消化系统及内分泌系统（无固定对应器官，体现中医整体观）</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>三焦气化失常、水湿内停、元气不足、三焦不通（腹胀、小便不利）</ns6:TCM_HAO_00000000000000000690>
        <ns6:TCM_TO_0000035>&quot;三焦是上焦、 中焦、 下焦的合称。 历代医家对三焦的形态和实质的认识不一，主要有两种观点： 一种认为三焦为六腑之一，和其他脏腑一样是具有综合功能的器官， 由千其与五脏无表里配合关系， 是分布千胸腹腔的一个 “大腑＂，故有 “孤府 ” 之称；另 一种认为三焦为划分内脏的区域部位， 即脱以上为上焦， 脱至肪为中焦， 肪以下为下焦。 三焦与心包由手少阳三焦经和手厥阴心包经的相互属络而构成表里关系。 三焦的主要生理功能为通行元气和运行水液。

三焦是上中下三焦的总称，为六腑之一。在人体脏腑中三焦最大，有名无实，有“孤腑”之称。从部位上来划分，膈肌以上为上焦，包括心肺；膈肌以下脐以上为中焦，包括肝，胆，脾胃；脐以下为下焦，包括大小肠，膀胱，肾。三焦与心包相表里。&quot;</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="zh-cn">tcm:三焦</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000667 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000667">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001303"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000679"/>
        <ns6:TCM_HAO_00000000000000000662 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000796"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000784"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000794"/>
        <ns6:TCM_HAO_00000000000000000663 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000796"/>
        <ns6:TCM_HAO_00000000000000000777 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003445"/>
        <ns6:TCM_TO_0000055 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000807"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000808"/>
        <ns6:TCM_TO_0000056 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000810"/>
        <ns6:TCM_HAO_00000000000000000658>胸腔中纵隔内，两肺之间，约2/3位于正中线左侧，1/3位于右侧，上连大血管，下邻膈</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000677>泵血推动全身血液循环、调节心率与心律、分泌心钠肽调节水盐平衡、维持心肌收缩与舒张的节律性</ns6:TCM_HAO_00000000000000000677>
        <ns6:TCM_HAO_00000000000000000772>心肌组织、结缔组织被膜、心内膜、心外膜，含心肌细胞、浦肯野纤维、血管与神经</ns6:TCM_HAO_00000000000000000772>
        <ns6:TCM_HAO_00000000000000000773>左心房、左心室、右心房、右心室；心壁分心内膜、心肌层、心外膜</ns6:TCM_HAO_00000000000000000773>
        <ns6:TCM_HAO_00000000000000000774>冠心病、心肌梗死、心律失常、心力衰竭、心肌病、心瓣膜病</ns6:TCM_HAO_00000000000000000774>
        <ns6:TCM_HAO_00000000000000000775>心率60-100次/分、血压90/60-120/80mmHg、心肌酶（CK-MB）、左心室射血分数（EF≥50%）</ns6:TCM_HAO_00000000000000000775>
        <ns6:TCM_HAO_00000000000000000776>循环系统（核心器官）</ns6:TCM_HAO_00000000000000000776>
        <ns6:TCM_TO_0000035>心脏是血管系的动力器官，位于胸腔内、两肺之间，像个前后略扁的圆锥体。心脏分为左、右心房和左、右心室4个腔。房中隔和室中隔把心脏分为左、右两半，每半又由房室口及周围的瓣膜分为上部的心房和下部的心室。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA6H07</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Heart</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>心脏</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1196650747</ns5:ICD11Reference>
        <ns4:FMAID rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7088</ns4:FMAID>
        <rdfs:label xml:lang="zh-cn">west:心脏</rdfs:label>
    </owl:NamedIndividual>
    


