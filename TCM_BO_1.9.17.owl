    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001672 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001672">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001516"/>
