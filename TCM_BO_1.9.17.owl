        <ns6:TCM_TO_0000035>商丘穴位于人体的足内踝前下方凹陷中，当舟骨结节与内踝尖连线的中点处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">商丘</rdfs:label>
        <rdfs:label xml:lang="zh-cn">商丘</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000289 -->

