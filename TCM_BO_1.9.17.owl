        <ns5:ICD11NameZH>颞叶</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1220842694</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">颞叶</rdfs:label>
        <rdfs:label xml:lang="zh-cn">颞叶</rdfs:label>
    </owl:Class>
    


