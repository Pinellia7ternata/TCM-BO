        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001672"/>
        <ns6:TCM_TO_0000035>贲门为七冲门之一。出《难经·四十四难》。指胃上口。其上与食管相接。贲通奔，投向、奔凑之意。食物从此处奔入于胃。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Cardia</rdfs:label>
        <rdfs:label xml:lang="zh-cn">贲门</rdfs:label>
    </owl:Class>
    


