        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014"/>
        <ns6:TCM_TO_0000035>下关穴位于头部侧面，耳前一横指，当颧弓与下颌切迹所形成的凹陷中，张口时隆起，闭口取穴。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA7L41</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Joints of lower extremity</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>下肢关节</ns5:ICD11NameZH>
