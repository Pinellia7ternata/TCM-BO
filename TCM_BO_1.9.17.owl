        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011"/>
        <ns6:TCM_TO_0000035>曲泽穴位于人体的肘横纹中，当肱二头肌腱的尺侧缘。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">曲泽</rdfs:label>
        <rdfs:label xml:lang="zh-cn">曲泽</rdfs:label>
    </owl:NamedIndividual>
    


