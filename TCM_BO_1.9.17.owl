        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Transitional epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">变移上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


