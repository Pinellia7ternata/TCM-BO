    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001771 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001771">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001770"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>感觉上皮（sensory epithelium）内有特殊分化并具有感受特殊刺激的细胞，如味蕾、嗅上皮，内耳位觉和听觉感受器及视网膜等；其中的视网膜是由神经组织构成，则为神经上皮（neuro epithelium）。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA56S9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Epithelium</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>上皮</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/461997709</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Sensory epithelium</rdfs:label>
        <rdfs:label xml:lang="zh-cn">感觉上皮</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


