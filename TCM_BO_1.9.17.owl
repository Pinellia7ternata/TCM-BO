                <owl:hasValue>Septal leaflet of tricuspid valve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns4:FMAID>7240</ns4:FMAID>
        <rdfs:label xml:lang="en">Others (alveoli, parietal layer of renal corpuscle, etc.)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">其他：肺泡、肾小囊壁层等</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7240"/>
