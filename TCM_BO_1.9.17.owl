                <owl:hasValue>Pericardial cavity proper</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10056005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>神经系统（nervous system）是人体内起主导作用的系统。内、外环境的各种信息，由感受器接受后，通过周围神经传递到脑和脊髓的各级中枢进行整合，再经周围神经控制和调节机体各系统器官的活动，以维持机体与内、外界环境的相对平衡。神经系统是由脑、脊髓、脑神经、脊神经、和植物性神经，以及各种神经节组成。能协调体内各器官、各系统的活动，使之成为完整的一体，并与外界环境发生相互作用。
神经的基本单位是神经元。反射弧的组成：感受器，传入神经冲动，神经中枢，传出神经冲动，效应器。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Nervous system</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>神经系统</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/340179422</ns5:ICD11Reference>
        <ns4:FMAID>9895</ns4:FMAID>
        <rdfs:label xml:lang="en">Nervous system</rdfs:label>
        <rdfs:label xml:lang="zh-cn">神经系统</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10056005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9895"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10056005"/>
    </owl:Class>
    


