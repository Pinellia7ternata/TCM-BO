        <ns6:TCM_TO_0000035 xml:lang="en">The posterior (cranial) surface of the auricle, opposite to the concave anterior surface.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>耳背面是耳廓朝向颅侧的后面，与耳廓前面的凹面相对。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA1V27</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Dorsal surface of tongue</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>舌背面</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2119547447</ns5:ICD11Reference>
        <ns4:FMAID>52780</ns4:FMAID>
        <rdfs:label xml:lang="en">Dorsal surface of tongue</rdfs:label>
        <rdfs:label xml:lang="zh-cn">耳背面</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma52780"/>
    </owl:Class>
    


