        <ns6:TCM_TO_0000035>臂臑穴位于人体的臂外侧，三角肌止点处，当曲池穴与肩髃穴连线上，曲池穴上七寸处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">臂臑</rdfs:label>
        <rdfs:label xml:lang="zh-cn">臂臑</rdfs:label>
    </owl:NamedIndividual>
    


