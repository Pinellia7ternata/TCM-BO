    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000276 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000276">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000245"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>External capsule of brain</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Vasculature of esophagus</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10517005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>脑的一部分。位于大脑的后下方，颅后窝内，延髓和脑桥的背面。可分为中间的蚓部和两侧膨大的小脑半球。小脑表面有许多大致平行的浅沟，沟间为一个叶片。表面的灰质为小脑皮层、深部为白质，也称髓质。白质内有数对核团，称中央核。小脑是运动的重要调节中枢，有大量的传入和传出联系。大脑皮质发向肌肉的运动信息和执行运动时来自肌肉和关节等的信息，都可传入小脑。小脑经常对这两种传来的神经冲动进行整合，并通过传出纤维调整和纠正各有关肌肉的运动，使随意运动保持协调。此外，小脑在维持身体平衡上也起着重要作用。它接受来自前庭器官的信息，通过传出联系，改变躯体不同部分肌肉的张力，使肌体在重力作用下，作加速或旋转运动时保持姿势平衡。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA1CW2</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Cerebellum</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>小脑</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/976604742</ns5:ICD11Reference>
        <ns4:FMAID>73751</ns4:FMAID>
        <rdfs:label xml:lang="en">Cerebellum</rdfs:label>
        <rdfs:label xml:lang="zh-cn">小脑</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10517005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma73751"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10517005"/>
    </owl:Class>
    


