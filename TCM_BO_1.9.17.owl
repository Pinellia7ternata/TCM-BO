    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000001 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000001">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003401"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000574"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000467"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000546"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000627"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>14031007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>经络，是经脉和络脉的总称，是运行全身气血，联络脏犹形体官窍， 沟通上下内外，感应传导信息的通路系统，是人体结构的重要组成部分。
经络，作为人体一种组织结构的名称，最早见于《内经》。《灵枢·本藏》说： “经脉者，所以行血气而营阴阳，濡筋骨， 利关节者也。”《灵枢·海论》说：“夫十二经脉者， 内属于腑脏，外络于肢节上。＂ 均指出经络是一种运行气血，沟通联系脏腑肢节及上下内外的 通道。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Meridian-collateral system (TCM)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">经络</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#14031007"/>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#368854007"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000002 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000002">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000001"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>脉是经络系统的主干，主要有正经、经别和奇经三大类。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Meridian</rdfs:label>
        <rdfs:label xml:lang="zh-cn">经脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000003 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000003">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000002"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000037"/>
        <ns6:TCM_TO_0000035>正经有十二，故又称“十二正经”或“十二经脉＂，包括手三阴经、足三阴经、手三阳经、 足三阳经。十二正经有一定的起止， 一定的循行部位和交接顺序，在肢体的分布及走向有一定的规律， 与脏腑有直接的络屈关系， 相互之间也有表里关系。十二正经是气血运行的主要通道。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0GB0</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Median nerve</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>正中神经</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/246233550</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">Regular meridians</rdfs:label>
        <rdfs:label xml:lang="zh-cn">正经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000004 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000004">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000003"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The three yang meridians of the hand (large intestine, sanjiao and small intestine meridians) that run along the lateral aspect of the upper limbs, linking the fu organs to the zang organs.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>手三阳经是手阳明大肠经、手少阳三焦经、手太阳小肠经的合称，为循行于上肢外侧、内属腑而络脏的三条阳经。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">手三阳经</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手三阳经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000005 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000005">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000660"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Small intestine part</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Right kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119213002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>十二经脉之一，手三阳经之一，与手少阴心经相表里，上接手少阴心经于小指，下接足太阳膀胱经于目内眦。经脉分布于手小指的尺侧、上肢外侧后缘、肩后及肩胛部、颈部、面颊、目外眦、耳中、目内眦。其络脉、经别分别与之内外相连，经筋分布于外部。本经首穴是少泽，末穴是听宫，左右各19穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7204</ns4:FMAID>
        <rdfs:label xml:lang="en">Small intestine meridian of hand-taiyang</rdfs:label>
        <ns6:TCM_TO_0000036 xml:lang="en">Small intestine part</ns6:TCM_TO_0000036>
        <rdfs:label xml:lang="zh-cn">手太阳小肠经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119213002"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/119213002"/>
        <skos:exactMatch rdf:resource="http://purl.org/sig/ont/fma/fma7204"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000006 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000006">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000660"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Small intestine part</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Duodenum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119213002</ns6:SNOMEDID>
        <ns6:SNOMEDID>119214008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>十二经脉之一，手三阳经之一，与手太阴肺经相表里，上接手太阴肺经于食指，下接足阳明胃经于鼻旁。经脉分布于食指、上肢外侧前、肩前、颈、颊、鼻旁。其络脉、经别分别与之内外相连，经筋分布于外部。本经首穴是商阳，末穴是迎香，左右各20穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7206</ns4:FMAID>
        <rdfs:label xml:lang="en">Large intestine meridian of hand-yangming</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手阳明大肠经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119214008"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7206"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/119213002"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000007 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000007">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000660"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Muscle structure of hand</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110540008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>十二经脉之一，手三阳经之一，与手厥阴心包经相表里，上接手厥阴心包经于无名指，下接足少阳胆经于目外眦。经脉分布于上肢外侧中间、肩颈和头面。其络脉、经别分别与之内外相连，经筋大体分布于经脉的外部。本经首穴是关冲，末穴是丝竹空，左右各23穴。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Triple Burner</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手少阳三焦经</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110540008"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000008 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000008">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Muscle structure of hand</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110540008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The three yin meridians of the hand (lung, pericardium and heart meridians) that run along the medial aspect of the upper limbs, linking the zang organs to the fu organs.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>手三阴经是手太阴肺经、手厥阴心包经、手少阴心经的合称，为循行于上肢内侧、内属脏而络腑的三条阴经。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">手三阴经</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手三阴经</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110540008"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000009 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000009">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Septal leaflet of tricuspid valve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>十二经脉之一，手三阴经之一，与手阳明大肠经相表里，上接足厥阴肝经于肺内，下接手阳明大肠经于食指。经脉分布于胸前、上肢内侧前、拇指桡侧。其络脉、经别分别与之内外相连，经筋分布于外部。本经首穴是中府，末穴是少商，左右各11穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7240</ns4:FMAID>
        <rdfs:label xml:lang="en">Lung meridian of hand-taiyin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手太阴肺经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10024003"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7240"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000010 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000010">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Heart part</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Heart</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119202000</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>十二经脉之一，手三阴经之一，与手太阳小肠经相表里，上接足太阴脾经于心中，下接手太阳小肠经于小指。经脉分布于腋下、上肢内侧后缘、掌中及手小指桡侧。其络脉、经别分别与之内外连接，经筋分布于外部。本经首穴是极泉，末穴是少冲，左右各9穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7088</ns4:FMAID>
        <rdfs:label xml:lang="en">Heart meridian of hand-shaoyin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手少阴心经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119202000"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7088"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/119202000"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Heart part</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Heart</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119202000</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>十二经脉之一，手三阴经之一，与手少阳三焦经相表里，上接足少阴肾经于胸中，下接手少阳三焦经于无名指。经脉分布于胸胁、上肢内侧中间、掌中、中指。其络脉、经别分别与之内外相连，经筋大体分布于经脉的外部。本经首穴是天池，末穴是中冲，左右各9穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7088</ns4:FMAID>
        <rdfs:label xml:lang="en">Pericardium meridian of hand-jueyin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">手厥阴心包经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119202000"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7088"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/119202000"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000012 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000012">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000003"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The three yang meridians of the foot (stomach, gallbladder and bladder meridians) that run along the lateral aspect of the lower limbs.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>足三阳经是足阳明胃经、足少阳胆经、足太阳膀胱经的合称，为循行于下肢外侧的三条阳经。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">足三阳经</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足三阳经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000013 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000013">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000660"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000018"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Nervous system</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>足太阳膀胱经从内眼角开始（睛明），上行额部（攒竹、眉冲、曲差；会神庭、头临泣），交会于头顶（五处、承光、通天；会百会）。它的支脉：从头顶分出到耳上角（会曲鬓、率谷、浮白、头窍阴、完骨）。本经一侧67穴（左右两侧共134穴），其中49穴分布于头面部、项部、和背腰部之督脉的两侧，余18穴则分布于下肢后面的正中线上及足的外侧部。首穴睛明，末穴至阴。主治泌尿生殖系统、神经精神方面、呼吸系统、循环系统、消化系统病症和热性病，以及本经脉所经过部位的病症。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7157</ns4:FMAID>
        <rdfs:label xml:lang="en">Perivesicular tissue of urinary bladder</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足太阳膀胱经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110626001"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7157"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000660"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Cardia of stomach</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>&quot;足阳明胃经是人体十二经脉之一。简称胃经。足阳明胃经分布在身体的正面，从眼部下边的承泣穴开始向下走，一直到脚部的厉兑穴，贯穿全身。本经一侧45穴（左右两侧共90穴合天九之极，应土生金之意，胃属土，45属金，90属金，也可译为经络生穴位之观点），其中15穴分布于下肢的前外侧面，30穴在腹、胸部与头面部，胃经有两条主线和四条分线。在人体经络当中是分支最多的一条经络。首穴承泣，末穴厉兑。主治肠胃等消化系统、神经系统、呼吸系统、循环系统某些病症和咽喉、头面、口、牙、鼻等器官病症，以及本经脉所经过部位之病症。
&quot;</ns6:TCM_TO_0000035>
        <ns4:FMAID>14561</ns4:FMAID>
        <rdfs:label xml:lang="en">Stomach meridian of foot-yangming</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足阳明胃经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#116209005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma14561"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000660"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>足少阳胆经简称胆经，是人体十二经脉之一，共四十四穴，原穴为丘墟穴，络穴为光明穴，少阳是阳气初生的经络，所以他能治疗发热病，主要大致在足部以下，他的性质介于阴阳明之间。足少阳胆经的位置：足少阳胆经起于瞳子髎穴、止于足窍阴穴，左右各44穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Gallbladder meridian of foot-shaoyang</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足少阳胆经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000016 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000016">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000003"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The three yin meridians of the foot (spleen, liver and kidney meridians) that run along the medial aspect of the lower limbs.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>足三阴经是足太阴脾经、足厥阴肝经、足少阴肾经的合称，为循行于下肢内侧的三条阴经。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">足三阴经</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足三阴经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of serous coat of spleen</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Left kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10945008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>阴脉指足太阴脾经，足太阴脾经在足大趾与足阳明胃经衔接，联系的脏腑器官有咽、舌，属脾，络胃，注心中，在胸部与手少阴心经相接。络脉从本经分出，走向足阳明经，进入腹腔，联络肠胃。经别结于咽，贯舌本。经筋结于髀，聚于阴器，上腹，结于脐，散于胸中。首穴是隐白，末穴是大包，左右各21穴。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7205</ns4:FMAID>
        <rdfs:label xml:lang="en">Spleen meridian of foot-taiyin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足太阴脾经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10945008"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7205"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10945008"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000018 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000018">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>足少阴肾经，简称肾经，是十二经脉之一，共27穴，左右合54穴，起于小趾之下，斜走足心，出于然谷之下，循内踝之后，别入跟中，以上踹内，出腘内廉， 上股内后廉， 贯脊属肾，络膀胱。 足少阴肾经与足太阳膀胱经相表里。主治泌尿生殖系统、神经精神方面病症、呼吸系统、消化系统和循环系统某些病症，以及本经脉所经过部位的病症。足少阴肾经，流注时辰为下午五至七点，即酉时。若小孩身体不好，在三至五岁时，父母可轻轻指压其脊骨两侧，从头椎至腰椎，能引导虚热下降。肾阳不足，水肿病会加强于肾经。肾脏强者才能长寿。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Kidney meridian of foot-shaoyin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足少阴肾经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Liver structure</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Liver</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10200004</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>足厥阴肝经，简称肝经。十二经脉之一。该经一侧有14个穴位（左右两侧共28穴），该经发生病变，主要临床表现为腰痛不可以俯仰，胸胁胀满，少腹疼痛，疝气，巅顶痛，咽干，眩晕，口苦，情志抑郁或易怒。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7197</ns4:FMAID>
        <rdfs:label xml:lang="en">Liver meridian of foot-jueyin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">足厥阴肝经</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10200004"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7197"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10200004"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000020 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000020">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000002"/>
        <ns6:TCM_TO_0000035>十二经别是指十二经脉由四肢肘、膝以上分别出来的，循行于胸、腹及头部的支脉。经别与本经经脉的其他分支不同，一般的分支别出以后再与本经相合，而十二经别，从阳经别出而循行体内后，仍回到本经；从阴经别出而循行体内后，却与相表里的阳经相合。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Twelve divergent meridians</rdfs:label>
        <rdfs:label xml:lang="zh-cn">十二经别</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000002"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000037"/>
        <ns6:TCM_TO_0000035>&quot;奇经八脉是任脉、督脉、冲脉、带脉、阴跷脉、阳跷脉、阴维脉、阳维脉的总称。它们与十二正经不同，既不直属脏腑，又无表里配合关系，其循行别道奇行，故称奇经。
其功能有：1、沟通十二经脉之间的联系；2、对十二经气血有蓄积渗灌等调节作用。&quot;</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Extraordinary meridians</rdfs:label>
        <rdfs:label xml:lang="zh-cn">奇经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000022 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000022">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>任脉，行于腹面正中线，其脉多次与手足三阴及阴维脉交会，能总任一身之阴经，故称：&quot;阴脉之海&quot;。任脉起于胞中，与女子妊娠有关，故有&quot;任主胞胎&quot;之说。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Conception vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">任脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000023 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000023">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>督脉，行于背部正中，其脉多次与手足三阳经及阳维脉交会，能总督一身之阳经，故称为&quot;阳脉之海&quot;。督脉行于脊里，上行入脑，并从脊里分出属肾，它与脑、脊髓、肾又有密切联系。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Governor vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">督脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000024 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000024">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>冲脉，上至于头，下至于足，贯穿全身；成为气血的要冲，能调节十二经气血故称&quot;十二经脉之海&quot;，又称&quot;血海&quot;。同妇女的月经有关。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000036>血海</ns6:TCM_TO_0000036>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Thoroughfare vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">冲脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000026 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000026">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>阴维脉、阳维脉：维，有维系之意。阴维脉的功能是&quot;维络诸阴&quot;；阳维脉的功能是&quot;维络诸阳&quot;。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Yang link vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">阳维脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000027 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000027">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>阴维脉、阳维脉：维，有维系之意。阴维脉的功能是&quot;维络诸阴&quot;；阳维脉的功能是&quot;维络诸阳&quot;。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Yin link vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">阴维脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000028 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000028">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>阴跷脉、阳跷脉：跷，有轻健跷捷之意。有濡养眼目、司眼睑开合和下肢运动的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Yang heel vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">阳跷脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000029 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000029">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000021"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>阴跷脉、阳跷脉：跷，有轻健跷捷之意。有濡养眼目、司眼睑开合和下肢运动的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Yin heel vessel</rdfs:label>
        <rdfs:label xml:lang="zh-cn">阴跷脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000030 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000030">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000001"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>中医指人体内气血运行通路的主干和分支。人体运行气血的通道。包括经脉和络脉两部分，其中纵行的干线称为经脉，由经脉分出网络全身各个部位的分支称为络脉。《灵枢·经脉》：“经脉十二者，伏行分肉之间，深而不见；其常见者，足太阴过于外踝之上，无所隐故也。诸脉之浮而常见者，皆络脉也。”经络的主要内容有：十二经脉、十二经别、奇经八脉、十五络脉、十二经筋、十二皮部等。其中属于经脉方面的，以十二经脉为主，属于络脉方面的，以十五络脉为主。它们纵横交贯，遍布全身，将人体内外、脏腑、肢节联成为一个有机的整体。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Collateral</rdfs:label>
        <rdfs:label xml:lang="zh-cn">络脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000034 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000034">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000001"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The affiliated part of the meridian system through which the twelve regular meridians connect with zang-fu organs, body constituents and sense orifices, including the twelve divergent meridians, twelve sinew meridians and twelve cutaneous regions.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>连属部分是经络系统中十二经脉与脏腑、形体、官窍相连属的部分，包括十二经别、十二经筋、十二皮部等。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">连属部分</rdfs:label>
        <rdfs:label xml:lang="zh-cn">连属部分</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000037 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000037">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000002"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Acupoint: a specific site on the body surface where the qi of zang-fu organs and meridians is transported and converges, serving as the locus for acupuncture, moxibustion and tuina therapies.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>穴位是脏腑经络之气输注于体表的特殊部位，是针灸、推拿等外治疗法的施术部位。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Acupoint</rdfs:label>
        <rdfs:label xml:lang="zh-cn">穴位</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>肝主疏泄，是指肝气具有疏通、畅达全身气机，进而促进精血津液的运行输布、脾胃之气的升降、胆汁的分泌排泄以及情志的舒畅等作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主疏泄</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主疏泄</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000424 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000424">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000034"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Medial part of lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>102292000</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The body region comprising the upper and lower limbs.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>四肢区域是人体上肢和下肢的统称部位。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA6AS2</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Extremities</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>四肢</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1810600222</ns5:ICD11Reference>
        <ns4:FMAID>0326592</ns4:FMAID>
        <rdfs:label xml:lang="en">Limbs region</rdfs:label>
        <rdfs:label xml:lang="zh-cn">四肢区域</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#102292000"/>
        <skos:exactMatch rdf:resource="http://purl.org/sig/ont/fma/fma0326592"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000425 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000425">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000034"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of medial head of gastrocnemius muscle</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Lateral wall of nasopharynx</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10476008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The body region comprising the head and the neck.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>头颈区域是人体头部与颈部的统称部位。</ns6:TCM_TO_0000035>
        <ns4:FMAID>0323588</ns4:FMAID>
        <ns4:FMAID>54908</ns4:FMAID>
        <rdfs:label xml:lang="en">Head and neck region</rdfs:label>
        <rdfs:label xml:lang="zh-cn">头颈区域</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10476008"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54908"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10476008"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000426 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000426">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000034"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The trunk region of the body excluding the head, neck and limbs, comprising the thoracic, abdominal, back and pelvic parts.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>躯干区域是人体除头颈、四肢以外的主体部位，包括胸部、腹部、背部和盆部。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA3FR3</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Trunk</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>躯干</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/947150833</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">躯干区域</rdfs:label>
        <rdfs:label xml:lang="zh-cn">躯干区域</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003401"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The collective term in TCM for the fundamental substances sustaining life activities (qi, blood and body fluids) together with the spirit (shen) that governs mental activities.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>气血津液神是中医学对维持人体生命活动的基本物质（气、血、津液）与精神活动主宰（神）的统称。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Qi, blood, body fluids and spirit</rdfs:label>
        <rdfs:label xml:lang="zh-cn">气血津液神</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000428 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000428">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000574"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000513"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000629"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000077"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000434"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000077"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000630"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>广义的精，泛指由气而化生的构成人体和维持生命活动的精微物质；狭义的精，指肾藏之精，即生殖之精，是促进人体生长发育和生殖功能的基本物质。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA9235</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Spermatic cord</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>精索</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/753469955</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">精</rdfs:label>
        <rdfs:label xml:lang="zh-cn">精</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000429 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000429">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427"/>
        <ns6:TCM_TO_0000035>中医学中的气是指人体内活力很强的运行不息的极其细微物质，是构成人体和维持人体生命活动的最基本物质。气运行不息，推动和调控着人体内的新陈代谢，维系着人体的生命进程。气的运动停止，则意味着生命的终止。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Qi</rdfs:label>
        <rdfs:label xml:lang="zh-cn">气</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000434 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000434">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
