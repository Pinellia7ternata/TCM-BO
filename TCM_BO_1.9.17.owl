        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014"/>
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000028"/>
        <ns6:TCM_TO_0000035>地仓穴位于人体的面部，口角外侧，上直对瞳孔。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">地仓</rdfs:label>
        <rdfs:label xml:lang="zh-cn">地仓</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000200 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000200">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014"/>
        <ns6:TCM_TO_0000035>大迎穴位于头部侧面下颌骨部位，嘴唇斜下、下巴骨的凹处（人体大迎穴位于下颌角前方，咬肌附着部前缘，当面动脉搏动处）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">大迎</rdfs:label>
        <rdfs:label xml:lang="zh-cn">大迎</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000201 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000201">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014"/>
        <ns6:TCM_TO_0000035>颊车穴位于头部侧面下颌骨边角上，向鼻子斜方向约一厘米处的凹陷中。（人体颊车穴位于面颊部，下颌角前上方约1横指(中指)，当咀嚼时咬肌隆起，按之凹陷处）。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA7MK8</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Cheek</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>颊</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1286369458</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">颊车</rdfs:label>
        <rdfs:label xml:lang="zh-cn">颊车</rdfs:label>
    </owl:NamedIndividual>
    


