        <ns5:ICD11NameZH>大阴唇</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/622913829</ns5:ICD11Reference>
        <ns4:FMAID>59612</ns4:FMAID>
        <rdfs:label xml:lang="en">Labium majus</rdfs:label>
        <rdfs:label xml:lang="zh-cn">大阴唇</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma59612"/>
    </owl:Class>
    


