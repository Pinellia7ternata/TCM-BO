        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011"/>
        <ns6:TCM_TO_0000035>天泉穴位于人体的臂内侧，当腋前纹头下２寸，肱二头肌的长、短头之间。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">天泉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">天泉</rdfs:label>
    </owl:NamedIndividual>
    


