        <ns6:TCM_TO_0000035>后顶穴位于人体的头部，当后发际正中直上5.5寸(脑户穴上3寸) 。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">后顶</rdfs:label>
        <rdfs:label xml:lang="zh-cn">后顶</rdfs:label>
