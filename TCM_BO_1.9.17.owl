    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000745 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000745">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000740"/>
        <ns5:ICD11ID_data>XA3FL3</ns5:ICD11ID_data>
