        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Kidney</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肾脏</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
    </owl:Class>
    


