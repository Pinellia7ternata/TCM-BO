    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000000 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000000">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003436"/>
        <ns5:ICD11ID_data>XA01U5</ns5:ICD11ID_data>
