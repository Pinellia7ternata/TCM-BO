            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000586"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Duodenum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>大肠，分为盲肠、阑尾、结肠、直肠和肛管，是对食物残渣中的水液进行吸收，而食物残渣自身形成粪便并有度排出的脏器。是人体消化系统的重要组成部分，为消化道的下段。大肠居于腹中，其上口在阑门处接小肠，其下端连接肛门。全程形似方框，围绕在空肠、回肠的周围。大肠在外形上与小肠有明显的不同，一般大肠口径较粗，肠壁较薄。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA1B13</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Large intestine</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>大肠</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1741413713</ns5:ICD11Reference>
        <ns4:FMAID>7206</ns4:FMAID>
        <rdfs:label xml:lang="en">Large intestine</rdfs:label>
        <rdfs:label xml:lang="zh-cn">大肠</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7206"/>
    </owl:Class>
    


