    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003420 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003420">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000670"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Ear</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035 xml:lang="en">The body of the helix: the main part of the free curved rim of the auricle, a surface landmark of the pinna.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>耳轮体是耳廓向前卷曲的游离缘的主体部分，为耳廓表面解剖标志之一。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA6B58</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Helix of pinna</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>耳轮</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/696331958</ns5:ICD11Reference>
        <ns4:FMAID>52780</ns4:FMAID>
        <rdfs:label xml:lang="en">Body of helix</rdfs:label>
        <rdfs:label xml:lang="zh-cn">耳轮体</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma52780"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003421 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003421">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000670"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Ear</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035 xml:lang="en">The superior crus of the antihelix: the upper anterior ridge branching from the antihelix of the auricle.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>对耳轮上脚是对耳轮向上前方分出的隆起，为耳廓表面解剖标志之一。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA96Q7</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Crura of antihelix</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>对耳轮脚</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/131196726</ns5:ICD11Reference>
        <ns4:FMAID>52780</ns4:FMAID>
        <rdfs:label xml:lang="en">Superior crus of antihelix</rdfs:label>
        <rdfs:label xml:lang="zh-cn">对耳轮上脚</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma52780"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003422 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003422">
