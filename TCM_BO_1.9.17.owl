        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000009"/>
        <ns6:TCM_TO_0000035>少商穴位于人体的手拇指末节桡侧，距指甲角0.1寸。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">少商</rdfs:label>
        <rdfs:label xml:lang="zh-cn">少商</rdfs:label>
    </owl:NamedIndividual>
    


