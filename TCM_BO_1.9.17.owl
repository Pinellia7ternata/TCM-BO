    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000636 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000636">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000627"/>
        <ns6:TCM_TO_0000035>泪器包括分泌泪液的泪腺及排泄泪液的泪道两部分。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0096</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lacrimal apparatus</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>泪器</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/28784496</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">泪器</rdfs:label>
        <rdfs:label xml:lang="zh-cn">泪器</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0000637 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000637">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000577"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000636"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003268"/>
        <ns6:TCM_TO_0000035>泪腺位于眼眶外上方的泪腺窝内，有排泄管10—20条，开口于外侧上穹窿结膜部，能分泌泪液，湿润眼球。泪液中含有少量溶菌酶和免疫球蛋白A，故有杀菌作用。血液供应来自泪腺动脉。泪腺神经为混合神经，由第V颅神经眼支、面神经中的副交感神经纤维和颈内动脉丛的交感神经纤维支配。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA75Y9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lacrimal gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>泪腺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/629756149</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">泪腺</rdfs:label>
        <rdfs:label xml:lang="zh-cn">泪腺</rdfs:label>
    </owl:Class>
    


