    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003403 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003403">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003402"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000698"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000736"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000025"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000736"/>
        <ns6:TCM_HAO_00000000000000000421>主温煦机体、防御外邪、排泄汗液、反映肺气血盛衰、依赖肺津濡养</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>覆盖全身体表，包括皮肤、皮毛、腠理，为人体第一道屏障</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>皮为肺所合，肺气血充盛则皮润毛茂，肺气虚则皮松毛枯、易受外邪，腠理开合主汗液排泄，与肺宣发肃降相关</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医全身皮肤组织、皮下组织、汗腺、皮肤感觉神经、皮肤免疫组织</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>皮燥、皮寒、皮热、腠理不固（伴自汗、易感冒）</ns6:TCM_HAO_00000000000000000690>
        <ns6:TCM_TO_0000035>五体中的皮指的是皮毛，是皮肤汗孔和毫毛的合称。皮的生理作用有护卫肌体调节水液代谢调节体温和调节呼吸四个方面。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0364</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Skin</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>皮肤</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/123461884</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Skin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">tcm:皮</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003404 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003404">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003402"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000598"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003406"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000704"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000704"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741"/>
        <ns6:TCM_HAO_00000000000000000421>主肢体丰满、辅助骨骼关节运动、受脾精濡养、反映脾胃气血盛衰、主固摄肢体肌肤</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>覆盖全身四肢、躯干，附着于骨骼与筋腱之间，包括肌肉、肌腠、皮下脂膜，四肢肌肉为甚</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>肉为脾所合，脾胃运化水谷精微充盛则肌肉丰满、肢体有力，脾胃气虚则肌肉消瘦、肢体乏力、肌腠不固；肉与筋、骨相合，共同维系肢体运动，肌腠为气血津液濡养肌肤的通道</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医全身骨骼肌组织、皮下脂肪组织、肌肉周围神经、脾胃营养代谢相关组织</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>肌肉消瘦、肌肉乏力、肌腠不固（伴自汗、肢体沉重、腹胀便溏）</ns6:TCM_HAO_00000000000000000690>
        <ns6:TCM_TO_0000035>五体中的肉是肌肉脂肪和皮下组织的合称，肌肉的纹理叫做腠理，皮毛下是腠，腠下是肉。肉的生理功能有主司运动和保护内脏两个方面。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Muscles</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>肌肉</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1448567552</ns5:ICD11Reference>
        <ns4:FMAID>9615</ns4:FMAID>
        <rdfs:label xml:lang="en">flesh (TCM)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">tcm:肉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003405 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003405">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003402"/>
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003474"/>
        <ns6:TCM_HAO_00000000000000000664 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000737"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000738"/>
        <ns6:TCM_HAO_00000000000000000421>主运行血液、反映心气血盛衰、联络全身脏腑形体、承载脉搏</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>遍布全身，包括经脉、络脉、孙脉，内联脏腑，外联形体官窍</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>脉为心所合，心气血充盛则脉道通利、脉搏和缓，心气虚则脉细弱、脉道瘀阻，脉是血液运行的通道，与心主血脉功能直接相关</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医全身血管（动脉、静脉、毛细血管）、心脏血管系统、脉搏感受器</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>脉细、脉涩、脉洪、脉结代（伴心悸、胸闷）</ns6:TCM_HAO_00000000000000000690>
        <ns6:TCM_TO_0000035>脉是气血运行的通道，又称脉道，脉管，血脉，血府。它是一个遍布全身相对密闭的管道系统。脉的生理功能主要包括运行气血和传递信息两个方面。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000036>脉管</ns6:TCM_TO_0000036>
        <ns6:TCM_TO_0000036>脉道</ns6:TCM_TO_0000036>
        <ns6:TCM_TO_0000036>血府</ns6:TCM_TO_0000036>
        <ns6:TCM_TO_0000036>血脉</ns6:TCM_TO_0000036>
        <ns5:ICD11ID_data>XA5999</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Arteries</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>动脉</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1933239759</ns5:ICD11Reference>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">vessel (TCM)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">tcm:脉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0003406 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003406">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003402"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000620"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000741"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000739"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000740"/>
        <ns6:TCM_HAO_00000000000000000421>主束骨利关节、主肢体运动、反映肝血盛衰、依赖肝血濡养</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>遍布全身，附着于骨骼与关节周围，包括肌腱、韧带、筋膜</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>筋为肝所合，肝血充盛则筋腱柔韧、肢体运动灵活，肝血虚则筋脉拘急、肢体麻木、关节不利，筋主约束骨骼，维持关节活动</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医全身肌腱、韧带、筋膜组织、骨骼肌附着点、周围运动神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>筋脉拘急、筋软无力、筋脉麻木（伴肢体活动不利）</ns6:TCM_HAO_00000000000000000690>
        <ns6:TCM_TO_0000035>筋是联结肌肉关节和骨骼的一种坚韧有力的条束状组织，是大筋小筋和筋膜的统称，中医五体的筋包括了现代医学中的肌腱和韧带。筋的生理功能有联结骨节和协助运动两个方面。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0200</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Iliacus muscle</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>骨筋</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2029243080</ns5:ICD11Reference>
        <ns4:FMAID>9726</ns4:FMAID>
        <rdfs:label xml:lang="en">sinew (TCM)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">tcm:筋</rdfs:label>
    </owl:NamedIndividual>
    


