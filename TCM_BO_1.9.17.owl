        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000707"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000764"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000765"/>
        <ns6:TCM_HAO_00000000000000000421>主司下肢内侧运动、调节肢体阴阳平衡、主司眼睑开合、濡养下肢内侧、主治下肢痿软/失眠/眼睑下垂</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于足内踝下，沿下肢内侧上行，经腹、胸，至目内眦，与阳跷脉相合，行于下肢内侧、胸腹内侧</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>阴跷脉为阴侧跷脉，与阳跷脉相合于目内眦，共主眼睑开合；行于下肢内侧，调节下肢内侧气血，与睡眠相关，阴跷脉盛则眠，阳跷脉盛则寤</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医下肢内侧皮神经、眼轮匝肌神经、胸腹内侧神经、下肢内侧运动神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>阴跷脉亏虚、阴跷脉气滞（伴下肢内侧痿软、失眠、眼睑下垂）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:阴跷脉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000763 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000763">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000028"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000579"/>
