        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000037"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Physiological functions of body structures as described in modern medical physiology.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>现代医学生理功能是现代医学生理学所阐述的人体结构功能活动的统称。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">现代医学生理功能</rdfs:label>
        <rdfs:label xml:lang="zh-cn">现代医学生理功能</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000458 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000458">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The TCM function of the heart governing blood and vessels: propelling blood circulation and governing the vessels as pathways of blood.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>主血脉是心主持血液在脉中运行的生理功能，包括主血（推动血行）与主脉（主持脉道）两个方面。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA6Y34</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Aorta</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>主动脉</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1480916274</ns5:ICD11Reference>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Governing blood and vessels</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主血脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000459 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000459">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000477"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>女子的排卵与月经来潮，与肝气的疏泄功能有密切关系。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">疏泄女子月经</rdfs:label>
        <rdfs:label xml:lang="zh-cn">疏泄女子月经</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000460 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000460">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000465"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>人体之神，有广义与狭义之分。广义之神，是整个人体生命活动的主宰和总体现；狭义之神，是指人的精神、意识、思维、情感活动及性格倾向等。心所藏之神，既是主宰人体生命活动的广义之神，又包括精神意识思维情志等狭义之神。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>心藏神，又称主神明或主神志，是指心有统帅全身脏腑、经络、形体、官窍的生理活动和主司精神、意识、思维、情志等心理活动的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">藏神</rdfs:label>
        <rdfs:label xml:lang="zh-cn">藏神</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000461 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000461">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000466"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000467"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The physiological process by which tissues and organs are perfused with blood through the vascular system.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>血液供应是机体通过血管系统向组织器官输送血液、保障其物质交换的生理过程。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8EC5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Blood</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>血液</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2062516965</ns5:ICD11Reference>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Blood supply</rdfs:label>
        <rdfs:label xml:lang="zh-cn">血液供应</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000462 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000462">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The process by which the immune system mounts a response against self antigens.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>自身免疫是机体免疫系统针对自身抗原成分产生免疫应答的生理或病理过程。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - Immune system</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>910012423</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/910012423</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - 免疫系统</ns6:hasICD11Name>
        <rdfs:label xml:lang="en">自身免疫</rdfs:label>
        <rdfs:label xml:lang="zh-cn">自身免疫</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000463 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000463">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000624"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The physiological function of maintaining body temperature homeostasis by balancing heat production and loss through neural and humoral mechanisms.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>体温调节是机体通过神经-体液机制调节产热与散热、维持体温相对恒定的生理功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">体温调节</rdfs:label>
        <rdfs:label xml:lang="zh-cn">体温调节</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000464 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000464">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000497"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000516"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000517"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Humoral regulation: the control of physiological activities by chemical substances (hormones, metabolites) transported through blood or tissue fluid.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>体液调节是机体通过体液中的化学物质（激素、代谢产物等）经血液或组织液运输而调节生理功能活动的方式。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">体液调节（功能）</rdfs:label>
        <rdfs:label xml:lang="zh-cn">体液调节（功能）</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000465 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000465">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000493"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of governing consciousness and thinking, attributed in TCM to the heart housing the spirit (shen) and to the brain.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>调控意识思维是中医学中心主神明功能的具体体现，即心与脑主宰人体意识、思维等精神活动的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">调控意识思维</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调控意识思维</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000466 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000466">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000458"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>心主血的另一内涵是心有生血的作用，即所谓“奉心化赤”。主要指饮食水谷经脾胃之气的运化，化为水谷之精，水谷之精再化为营气和津液，营气和津液入脉，经心火（即心阳）的作用，化为赤色血液，即《素问·经脉别论》所谓“浊气归心，淫精与脉。”清·唐宗海《血证论》说：“火者，心之所主，化生为血液以濡养周身。”可见，心有总司一身血液的运行及生成的作用。若心火虚衰，可致血液化生障碍。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>心气能推动血液运行，以输送营养物质于全身脏腑形体官窍。人体各脏腑器官、四肢百骸、肌肉皮毛以及心脉自身，皆有赖于血液的濡养，才能发挥其正常的生理功能，以维持生命活动。血液的运行与五脏机能能密切相关，其中心的搏动泵血作用尤为重要。而心脏的搏动，主要依赖心气的推动和调控作用。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Governing blood</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主血</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000467 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000467">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000458"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>心主脉，是指心气推动和调控心脏的搏动和脉管的舒缩，使脉道通利，血流通畅。心与脉直接相连，形成一个密闭循环的管道系统。心气充沛，心脏有规律的搏动，脉管有规律的舒缩，血液则被输送到各脏腑形体官窍，发挥濡养作用，以维持人体正常的生命活动。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA6Y34</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Aorta</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>主动脉</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1480916274</ns5:ICD11Reference>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Governing the vessels</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000468 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000468">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肝贮藏充足的血量，肝藏血而称为血海，冲脉起于胞中而通于肝，于女子月经来潮密切相关，也称为血海。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8EC5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Blood</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>血液</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2062516965</ns5:ICD11Reference>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Storing blood</rdfs:label>
        <rdfs:label xml:lang="zh-cn">贮藏血液</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    
        <ns6:TCM_TO_0000036 xml:lang="zh-cn">储血</ns6:TCM_TO_0000036>
        <ns6:TCM_TO_0000036 xml:lang="en">Storing blood</ns6:TCM_TO_0000036>
        <rdfs:comment xml:lang="zh-cn">1.9.15 经三专家复核与PI裁决，由 TCM_HAO_00000000000000000548（储血）合并入本类，公理与映射注解已迁移。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Blood storage: in TCM the liver stores blood; in modern medicine the reservoir function of the liver and spleen.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>储血是贮存血液以备应急动用的功能；中医指肝藏血，现代医学指肝、脾等储血库器官的功能。</ns6:TCM_TO_0000035></owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000469 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000469">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肝贮藏充足的血液，可根据生理需要调节人体各部分血量的分配。在正常情况下，人体各部分的血量，是相对恒定的。但是随着机体活动量的增减、情绪的变化、外界气候的变化等因素，人体各部分的血量也随之有所变化。这种变化是通过肝的藏血和疏泄机能实现的。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Regulating blood volume</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节血量</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000470 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000470">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肝主凝血以防止出血。气有固摄血液之能，肝气充足，则能固摄肝血而不致出血；又因阴气主凝，肝阴充足，肝阳被涵，阴阳协调，则能发挥凝血功能而防止出血。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Preventing bleeding</rdfs:label>
        <rdfs:label xml:lang="zh-cn">防止出血</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000471 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000471">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Autoregulation: the adaptive response of a tissue or organ to stimuli, independent of extrinsic neural and humoral influences.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>自身调节是组织器官在不依赖外来神经与体液因素的情况下、自身对刺激产生的适应性反应。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">自身调节</rdfs:label>
        <rdfs:label xml:lang="zh-cn">自身调节</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Surface of subdivision of thorax</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>118971007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The endocrine function of dispersed enteroendocrine cells of the gastrointestinal mucosa that secrete gut hormones regulating digestive activities.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>消化道内分泌是消化道黏膜内散在的内分泌细胞合成并分泌胃肠激素、调节消化活动的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>0326493</ns4:FMAID>
        <rdfs:label xml:lang="en">Digestive system subdivision</rdfs:label>
        <rdfs:label xml:lang="zh-cn">消化道内分泌</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118971007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma0326493"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000473 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000473">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000631"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Metabolism: the processes of material and energy exchange between the body and the environment and of internal material and energy transformation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>代谢是机体与外界环境之间进行物质和能量交换、以及体内物质和能量自我更新转变的过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">代谢</rdfs:label>
        <rdfs:label xml:lang="zh-cn">代谢</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000474 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000474">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000581"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000473"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The absorption, transformation, utilization and excretion of vitamins in the body.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>维生素代谢是维生素在体内吸收、转化、利用与排泄的过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">维生素代谢</rdfs:label>
        <rdfs:label xml:lang="zh-cn">维生素代谢</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000475 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000475">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000473"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The synthesis, secretion, transport, transformation and inactivation of hormones in the body.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>激素代谢是激素在体内合成、分泌、运输、转化与灭活的过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">激素代谢</rdfs:label>
        <rdfs:label xml:lang="zh-cn">激素代谢</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000476 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000476">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000473"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The intake, distribution, exchange and excretion of water and electrolytes in the body.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>体液代谢是体内水与电解质的摄入、分布、交换与排出的过程。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA06R8</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Body fluid</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>体液</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/230624298</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">体液代谢</rdfs:label>
        <rdfs:label xml:lang="zh-cn">体液代谢</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000477 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000477">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000475"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Sex hormones secreted by the gonads that regulate the development of reproductive organs, reproductive functions and secondary sexual characteristics.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>性激素是由性腺分泌、调节生殖器官发育、生殖功能与第二性征的一类激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">性激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">性激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000478 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000478">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The physiological function of hepatocytes synthesizing and secreting bile into the bile canaliculi.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>分泌胆汁是肝细胞合成胆汁并排入胆小管的生理功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Bile secretion</rdfs:label>
        <rdfs:label xml:lang="zh-cn">分泌胆汁</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000479 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000479">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The physiological process of discharging bile into the duodenum through gallbladder contraction and sphincter relaxation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>排放胆汁是胆囊收缩、胆道括约肌舒张而将胆汁排入十二指肠的生理过程。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Discharging bile</rdfs:label>
        <rdfs:label xml:lang="zh-cn">排放胆汁</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000480 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000480">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Blood production: hematopoiesis by bone marrow in modern medicine; in TCM, the production of blood from food essence transformed by the spleen and stomach.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>造血是生成血细胞的生理过程；现代医学指骨髓等造血器官的血细胞生成，中医学指脾胃化生水谷精微以化生血液。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Haematopoietic system</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>造血系统</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/256187719</ns5:ICD11Reference>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Producing blood (hematopoiesis)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">造血</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000481 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000481">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of immune and other cells synthesizing and secreting cytokines that mediate immune and inflammatory responses.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>分泌细胞因子是免疫细胞及其他细胞合成并分泌细胞因子、介导免疫与炎症反应的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">分泌细胞因子</rdfs:label>
        <rdfs:label xml:lang="zh-cn">分泌细胞因子</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000482 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000482">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000569"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000481"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Coagulation factors: plasma proteins that participate in blood coagulation through cascade activation leading to fibrin formation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>凝血因子是参与血液凝固过程的一类血浆蛋白质，经级联激活促使纤维蛋白形成。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Coagulation factors</rdfs:label>
        <rdfs:label xml:lang="zh-cn">凝血因子</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000483 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000483">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000481"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Anticoagulant substances in blood that inhibit the coagulation cascade and maintain blood fluidity.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>抗凝物质是血液中抑制凝血级联反应、维持血液流体状态的一类物质。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">抗凝物质</rdfs:label>
        <rdfs:label xml:lang="zh-cn">抗凝物质</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000484 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000484">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Liver structure</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10200004</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肝贮藏充足的血液，化生和涵养肝气，使之冲和畅达，发挥其正常的疏泄功能，防止疏泄太过而亢逆。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Nourishing liver qi</rdfs:label>
        <rdfs:label xml:lang="zh-cn">涵养肝气</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10200004"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10200004"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000485 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000485">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Liver structure</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Liver</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10200004</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肝贮藏充足的血液，可濡养肝脏及其形体官窍，使其发挥正常的生理机能。如《素问·五藏生成》说：＂肝受血而能视，足受血而能步，掌受血而能握，指受血而能摄。“</ns6:TCM_TO_0000035>
        <ns4:FMAID>7197</ns4:FMAID>
        <rdfs:label xml:lang="en">Nourishing the liver, sinews and eyes</rdfs:label>
        <rdfs:label xml:lang="zh-cn">濡养肝及筋目</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10200004"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7197"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10200004"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000486 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000486">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Proximal stomach structure</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Cardia of stomach</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>116209005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Gastric motility: contraction and relaxation of gastric smooth muscle for receiving, grinding and emptying food into the duodenum.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>胃的运动是胃壁平滑肌收缩与舒张以容纳、研磨食物并将其排入十二指肠的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>14561</ns4:FMAID>
        <rdfs:label xml:lang="en">Gastric motility</rdfs:label>
        <rdfs:label xml:lang="zh-cn">胃的运动</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#116209005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma14561"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/116209005"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000487 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000487">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000513"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Reproduction: the physiological function of producing germ cells and offspring to perpetuate the species.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>生殖是生物体产生生殖细胞、繁衍后代以延续种系的生理功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA5FG3</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Genital region</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>生殖区</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/743024263</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">Reproduction</rdfs:label>
        <rdfs:label xml:lang="zh-cn">生殖</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000488 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000488">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000487"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Male reproduction: spermatogenesis, androgen secretion and completion of the reproductive process by the male reproductive system.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>男性生殖是男性生殖系统产生精子、分泌雄激素并完成生殖过程的功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA75A2</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Male genital organs</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>男性生殖器官</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1678247922</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">Male reproduction</rdfs:label>
        <rdfs:label xml:lang="zh-cn">男性生殖</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000487"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Female reproduction: oogenesis, estrogen and progesterone secretion, and gestation by the female reproductive system.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>女性生殖是女性生殖系统产生卵子、分泌雌孕激素并孕育胚胎的功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA2GU7</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Female genital organs</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>女性生殖器官</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/344632447</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">Female reproduction</rdfs:label>
        <rdfs:label xml:lang="zh-cn">女性生殖</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000490 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000490">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The action of estrogens in promoting the development and maintenance of female secondary sexual characteristics.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促进女性第二性征发育是雌激素促进乳腺发育、骨盆增宽等女性第二性征出现与维持的作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">促进女性第二性征发育</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进女性第二性征发育</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000491 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000491">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000489"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The promotion of oviduct peristalsis by hormonal and neural factors to facilitate gamete and zygote transport.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促进输卵管运动是激素与神经因素促进输卵管蠕动、以利于配子与受精卵运输的作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">促进输卵管运动</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进输卵管运动</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000492 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000492">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000488"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The action of androgens in promoting the development and maintenance of male secondary sexual characteristics.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促进男性第二性征发育是雄激素促进胡须生长、声调变低等男性第二性征出现与维持的作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">促进男性第二性征发育</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进男性第二性征发育</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000493 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000493">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of ophthalmic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Pericardial cavity proper</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10056005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Neural regulation: the rapid and precise control of physiological functions by the nervous system through reflex activities.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>神经调节是神经系统通过反射活动迅速而精确地调节机体生理功能的方式。</ns6:TCM_TO_0000035>
        <ns4:FMAID>0326203</ns4:FMAID>
        <ns4:FMAID>9895</ns4:FMAID>
        <rdfs:label xml:lang="en">Neural regulation (function)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">神经调节（功能）</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10056005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9895"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10056005"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000494 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000494">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Surface of subdivision of thorax</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>118969007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肺主气，首见于 《内经》。《素问·五藏生成》说：“诸气者，皆属千肺。＂</ns6:TCM_TO_0000035>
        <ns4:FMAID>0326493</ns4:FMAID>
        <rdfs:label xml:lang="en">Governing respiration</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主其司呼吸</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118969007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma0326493"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000495 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000495">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Surface of subdivision of thorax</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000496"/>
        <ns6:SNOMEDID>118969007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肺主呼吸之气，是指肺是气体交换的场所。如《素间·阴阳应象大论》说：“天气通于肺。“通过肺的呼吸作用，不断吸进清气，排出浊气，吐故纳新，实现 机体与外界环境之间的气体交换，以维持人体的生命活动。</ns6:TCM_TO_0000035>
        <ns4:FMAID>0326493</ns4:FMAID>
        <rdfs:label xml:lang="en">Governing respiratory qi</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主呼吸之气</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118969007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma0326493"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000496 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000496">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000494"/>
        <ns6:TCM_TO_0000035>肺主一身之气，是指肺有主司一身之气的生成和运行的作用。故《素间．六节藏象论》说：＂肺者，气之本。”</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主一身之气</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主一身之气</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000497 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000497">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>肺气的宣发肃降运动推动和调节全身水液的输布和排泄。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主行水</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主行水</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000498 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000498">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000511"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>全身的血脉均统属于心，心气是血液循环运行的基本动力。而血液的运行，又赖于肺气的推动和搁节，即肺气具有助心行血的作用。肺通过呼吸运动，调节全身气机，从而促进血液运行。故《素问·平人气象论》说：“人一呼脉再动，一吸脉亦再动。”</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>肺朝百脉，是指全身的血液都通过百脉流经于肺，经肺的呼吸，进行体内外清浊之气的交换，然后再通过肺气宣降作用，将富有清气的血液通过百脉输送到全身。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Convergence of all vessels (lung)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">朝百脉</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000499 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000499">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000507"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>主治节，是指肺气具有治理调节肺之呼吸及全身之气、血、水的作用。《素间·灵兰秘典论》说： ＂肺者，相傅之官，治节出焉。＂</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>肺主治节的生理作用主要表现在四个方面： 一是治理调节呼吸运动：肺气的宣发与肃降运动协调，维持通畅均匀的呼吸，使体内外气体得以正常交换；二是调理全身气机：通过呼吸运动， 洞节一身之气的升降出入，保持全身气机调畅；三是治理调节血液的运行：通过肺朝百脉和气的升降出人运动，辅佐心脏，推动和 洞节血液的运行；四是治理诮节津液代谢：通过肺气的宣发与肃降，治理和询节全身水液的输布与排泄。由此可见，肺主治节，是对肺的主要生理机能的高度概括。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主治节</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主治节</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000500 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000500">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000499"/>
        <ns6:TCM_TO_0000035>治理调节呼吸运动：肺气的宣发与肃降运动协调，维持通畅均匀的呼吸，使体内外气体得以正常交换</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">体内外气体交换</rdfs:label>
        <rdfs:label xml:lang="zh-cn">体内外气体交换</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000501 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000501">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000499"/>
        <ns6:TCM_TO_0000035>调理全身气机：通过呼吸运动， 洞节一身之气的升降出入，保持全身气机调畅</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">调节全身气机</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节全身气机</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000502 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000502">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000499"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000503"/>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>治理调节血液的运行：通过肺朝百脉和气的升降出人运动，辅佐心脏，推动和 洞节血液的运行</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Regulating blood circulation</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节血液运行</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000503 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000503">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000499"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>治理诮节津液代谢：通过肺气的宣发与肃降，治理和询节全身水液的输布与排泄。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">调节津液代谢</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节津液代谢</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000504 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000504">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000507"/>
        <ns6:SNOMEDID>118969007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肺与外环境之间的气体交换（肺通气）以及肺泡与肺毛细血管血液之间的气体交换（肺换气）过程。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000036>external respiration</ns6:TCM_TO_0000036>
        <rdfs:label xml:lang="en">External respiration</rdfs:label>
        <rdfs:label xml:lang="zh-cn">外呼吸</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118969007"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000505 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000505">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001451"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of base of lung</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Septal leaflet of tricuspid valve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10024003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肺是人体的呼吸器官，位于胸腔，左右各一，覆盖于心之上。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>解剖结构：肺上端钝圆叫肺尖，向上经胸廓上口突入颈根部，底位于膈上面，对向肋和肋间隙的面叫肋面，朝向纵隔的面叫内侧面，该面中央的支气管、血管、淋巴管和神经出入处叫肺门，这些出入肺门的结构，被结缔组织包裹在一起叫肺根。左肺由斜裂分为上、下二个肺叶，右肺除斜裂外，还有一水平裂将其分为上、中、下三个肺叶。肺是以支气管反复分支形成的支气管树为基础构成的。
左、右支气管在肺门分成第二级支气管，第二级支气管及其分支所辖的范围构成一个肺叶，每支第二级支气管又分出第三级支气管，每支第三级支气管及其分支所辖的范围构成一个肺段，支气管在肺内反复分支可达23-25级，最后形成肺泡。支气管各级分支之间以及肺泡之间都由结缔组织性的间质所填充，血管、淋巴管、神经等随支气管的分支分布在结缔组织内。肺泡之间的间质内含有丰富的毛细血管网，毛细血管膜与肺泡共同组成呼吸膜，血液和肺泡内气体进行气体交换必须通过呼吸膜才能进行，呼吸膜面积较大，平均约70平方米，安静状态下只动用其中40平方米用于呼吸时的气体交换，是肺呼吸的重要组成。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA57M6</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lung</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>肺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1338477196</ns5:ICD11Reference>
        <ns4:FMAID>7240</ns4:FMAID>
        <rdfs:label xml:lang="en">Lung</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肺脏</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10024003"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7240"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10024003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000507 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000507">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000519"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:SNOMEDID>118969007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Respiration: gas exchange between the body and the environment, comprising external respiration, gas transport in blood and internal respiration.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>呼吸是机体与外界环境之间进行气体交换的生理过程，包括外呼吸、气体在血液中的运输和内呼吸三个环节。</ns6:TCM_TO_0000035>
        <ns5:ICD11NameEN>Respiratory system</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>呼吸系统</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/57597214</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">Respiration</rdfs:label>
        <rdfs:label xml:lang="zh-cn">呼吸</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118969007"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000508 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000508">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000507"/>
        <ns6:SNOMEDID>118969007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>组织毛细血管血液与组织细胞之间的气体交换以及组织细胞的生物氧化过程。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000036>internal respiration</ns6:TCM_TO_0000036>
        <rdfs:label xml:lang="en">Internal respiration</rdfs:label>
        <rdfs:label xml:lang="zh-cn">内呼吸</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#118969007"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000509 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000509">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Urine formation and excretion: urine production by glomerular filtration, tubular reabsorption and secretion, and its discharge through the ureter, bladder and urethra.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>尿的生成与排出是肾脏经肾小球滤过、肾小管重吸收与分泌生成尿液，并经输尿管、膀胱、尿道排出体外的生理过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">尿的生成与排出</rdfs:label>
        <rdfs:label xml:lang="zh-cn">尿的生成与排出</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000510 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000510">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The TCM function of the kidney storing and retaining congenital and acquired essence as the material basis for growth, development and reproduction.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>藏精是肾贮存和封藏先天之精与后天之精、为生长发育生殖提供物质基础的生理功能（中医）。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">藏精</rdfs:label>
        <rdfs:label xml:lang="zh-cn">藏精</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000511 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000511">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000507"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Gas transport by blood: carriage of oxygen from the lungs to the tissues and of carbon dioxide from the tissues to the lungs.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>血液对气体的运输是血液将氧从肺运输至组织、将二氧化碳从组织运输至肺的生理功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Gas transport by blood</rdfs:label>
        <rdfs:label xml:lang="zh-cn">血液对气体的运输</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000512 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000512">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000510"/>
        <ns6:TCM_TO_0000035>肾藏精，是指肾具有贮存、封藏精的生理机能。故《素问．六节藏象论》说：＂肾者，主垫，封藏之本，精之处也。“ 精得藏于肾，发挥其生理效应而不无故流失， 依赖于肾气的闭藏作用和激发作用的协调。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">藏精(功能）</rdfs:label>
        <rdfs:label xml:lang="zh-cn">藏精(功能）</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000513 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000513">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000510"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>肾主生长发育和生殖，是肾精及其所化肾气的生理作用。肾藏精，精化气，肾精所化之气为肾气，肾稍足则肾气充，肾精亏则肾气衰。因而人体的生、 长、壮、老、己的生命过程，以及在生命过程中的生殖能力，都取决于肾精及肾气的盛衰。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Governing growth, development and reproduction</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主生长发育和生殖</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000514 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000514">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Airway responsiveness: the sensitivity of the airways to constrict in response to physical, chemical or pharmacological stimuli.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>气道反应性是气道对各种物理、化学或药物刺激产生收缩反应的敏感程度。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">气道反应性</rdfs:label>
        <rdfs:label xml:lang="zh-cn">气道反应性</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000515 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000515">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000510"/>
        <ns6:TCM_TO_0000035>脏腑气化，是指由脏腑之气的升降出入运动推动和调控着各脏腑形体官窍的生理机能，进而推动和调控着机体精气血津液各自的新陈代谢及其与能匮 的相互转化的过程。肾精、肾气及其分化的肾阴、肾阳在推动和调控脏腑气化过程中起着极 其孤要的作用。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">推动和调控脏腑气化</rdfs:label>
        <rdfs:label xml:lang="zh-cn">推动和调控脏腑气化</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000516 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000516">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>肾主水，是指肾气具有主司和调节全身水液代谢的功能。《素间·逆调论》说：＂肾者水藏，主津液。“水液的输布和排泄是一个十分复杂的生理过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主水</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主水</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000517 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000517">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000516"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肾气及肾阴肾阳对水液代谢过程中各脏腑 之气的功能，尤其是脾肺之气的运化和输布水液的功能，具有促进和调节作用。水液代谢过 程中，胃、小肠、大肠中的水液，经脾气的运化转输作用，吸收并输送至肺，再经肺气的直发肃降运动输布周身，以发挥滋润和濡养作用，并将输布至皮毛肌胺的水液化为汗液排泄；脏腑形体官窍代谢后所产生的浊液（废水），由肺气的肃降运动输送到肾或膀胱，再经肾气 的蒸化作用，吸收可再利用者，而将剩余的化为尿液排泄。可见，机体水液的输布与排泄， 是在肺、脾、肾、胃、大肠、小肠、三焦、膀胱等脏腑的共同参与下完成的。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Kidney qi promoting the water-fluid metabolism of zang-fu organs</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肾气对参与水液代谢脏腑的促进作用</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000518 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000518">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000516"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>尿的生成和排泄是水液代谢的一个重要环节。水液代谢过程中，各脏腑形体官窍代谢后产生的浊液（废水），通过三焦水道下输于肾或膀胱，在肾 气的蒸化作用下，分为清浊：清者回吸收，由脾气的转输作用通过三焦水道上腾于肺，重新 参与水液代谢；浊者则化为尿液，在肾与膀胱之气的推动作用下排出体外。可见，只有肾阴 肾阳协调平衡，肾气的蒸化和推动作用发挥正常，输千肾或膀胱的水液才能升消降浊，化生 尿液和排泄尿液。肾气的蒸化作用及其肾阴与肾阳的推动和调控作用的协调，对千维持体内 水液代谢的平衡是非常重要的。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Kidney qi&apos;s role in urine production and excretion</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肾气的生尿和排尿作用</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000519 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000519">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>肾主纳气，是指肾气有摄纳肺所吸人的自然界清气，保持吸气的深度，防止呼吸表浅作用。人体的呼吸机能，由肺所主，其中呼气主要依赖肺气的宜发运动，吸气主要依赖肺气的肃降运动。但吸人的清气，由肺气的肃降下达于肾，必须再经肾气的摄纳潜藏，使其维持一定的深度 ， 以利于气体的交换。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主纳气</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主纳气</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000520 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000520">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002788"/>
        <ns6:TCM_TO_0000035 xml:lang="en">The principal hormones secreted by a given endocrine gland or tissue.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>主要激素是某一内分泌腺或组织所分泌的主要激素类别的统称。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主要激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主要激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000521 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000521">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000520"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Trunk of right first thoracic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110488009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Cortisol: a glucocorticoid secreted by the zona fasciculata of the adrenal cortex, involved in gluconeogenesis, stress response and immune modulation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>皮质醇是肾上腺皮质束状带分泌的糖皮质激素，参与糖异生、应激反应与免疫调节。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA5CF8</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Visual cortex</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>视皮质</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1720999238</ns5:ICD11Reference>
        <ns4:FMAID>7022</ns4:FMAID>
        <rdfs:label xml:lang="en">Cortisol</rdfs:label>
        <rdfs:label xml:lang="zh-cn">皮质醇</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110488009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7022"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000522 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000522">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000520"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Aldosterone: a mineralocorticoid secreted by the zona glomerulosa that promotes sodium retention and potassium excretion in the distal tubule.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>醛固酮是肾上腺皮质球状带分泌的盐皮质激素，促进肾远曲小管保钠排钾、调节水盐代谢。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">醛固酮</rdfs:label>
        <rdfs:label xml:lang="zh-cn">醛固酮</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000523 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000523">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000520"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Androgen: a steroid hormone mainly secreted by Leydig cells and the adrenal cortex that promotes male characteristics and spermatogenesis.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>雄激素是主要由睾丸间质细胞及肾上腺皮质分泌、促进男性性征与精子发生的类固醇激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">雄激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">雄激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000524 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000524">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002791"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Posterior surface of ninth costal cartilage</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>120638006</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Adrenal medullary hormones: the hormones secreted by chromaffin cells of the adrenal medulla, chiefly epinephrine and norepinephrine.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>髓质激素是肾上腺髓质嗜铬细胞分泌的激素（主要为肾上腺素与去甲肾上腺素）的统称。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA17J6</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Medulla oblongata</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>髓质</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1283174126</ns5:ICD11Reference>
        <ns4:FMAID>8361</ns4:FMAID>
        <rdfs:label xml:lang="en">Medullary hormones</rdfs:label>
        <rdfs:label xml:lang="zh-cn">髓质激素</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#120638006"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma8361"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000525 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000525">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000524"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Epinephrine: a catecholamine secreted by the adrenal medulla that strengthens cardiac contraction, accelerates heart rate and raises blood glucose.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>肾上腺素是肾上腺髓质分泌的儿茶酚胺类激素，增强心肌收缩、加快心率、升高血糖。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0NE9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Adrenal gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>肾上腺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/72373228</ns5:ICD11Reference>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Epinephrine</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肾上腺素</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000526 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000526">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000524"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Norepinephrine: a catecholamine released by the adrenal medulla and sympathetic postganglionic fibers that causes vasoconstriction and elevates blood pressure.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>去甲肾上腺素是肾上腺髓质及交感节后纤维释放的儿茶酚胺，主要引起血管强烈收缩、升高血压。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA0NE9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Adrenal gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>肾上腺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/72373228</ns5:ICD11Reference>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Norepinephrine</rdfs:label>
        <rdfs:label xml:lang="zh-cn">去甲肾上腺素</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000527 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000527">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000524"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Adrenomedullin: a peptide hormone secreted by the adrenal medulla with vasodilatory and hypotensive actions.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>肾上腺髓质素是肾上腺髓质分泌的具有扩张血管、降低血压作用的多肽类激素。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA6SS0</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Adrenal medulla</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>肾上腺髓质</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1636396460</ns5:ICD11Reference>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Adrenomedullin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">肾上腺髓质素</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000209"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Adenohypophysis: the anterior lobe of the pituitary composed of glandular cells that secrete tropic hormones regulating the thyroid, adrenal cortex and gonads.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>腺垂体是垂体的前叶部分，由腺细胞构成，分泌多种促激素以调节甲状腺、肾上腺皮质、性腺等靶腺功能。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8J35</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Pituitary gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>垂体</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/294069435</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">腺垂体</rdfs:label>
        <rdfs:label xml:lang="zh-cn">腺垂体</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000529 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000529">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Thyroid-stimulating hormone: an adenohypophyseal tropic hormone that promotes thyroid growth and the synthesis and release of thyroid hormones.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促甲状腺激素是腺垂体分泌、促进甲状腺生长发育及甲状腺激素合成释放的促激素。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8RK3</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Thyroid gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>甲状腺</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/485621173</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">促甲状腺激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促甲状腺激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000530 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000530">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Papillary duct of kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Gallbladder</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>110623009</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Adrenocorticotropic hormone: an adenohypophyseal tropic hormone that promotes adrenal cortical growth and glucocorticoid secretion.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促肾上腺皮质激素是腺垂体分泌、促进肾上腺皮质增生及糖皮质激素分泌的促激素。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8956</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Adrenal cortex</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>肾上腺皮质</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/1990265196</ns5:ICD11Reference>
        <ns4:FMAID>7202</ns4:FMAID>
        <rdfs:label xml:lang="en">Adrenocorticotropic hormone</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促肾上腺皮质激素</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#110623009"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7202"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/110623009"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000531 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000531">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Follicle-stimulating hormone: a gonadotropin of the adenohypophysis that promotes follicular development or spermatogenesis.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>卵泡刺激素是腺垂体分泌、促进卵泡发育成熟或睾丸精子发生的促性腺激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">卵泡刺激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">卵泡刺激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000532 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000532">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Luteinizing hormone: a gonadotropin that promotes ovulation, corpus luteum formation and sex steroid secretion.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>黄体生成素是腺垂体分泌、促进排卵、黄体形成及性激素分泌的促性腺激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">黄体生成素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">黄体生成素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000533 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000533">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Growth hormone: an adenohypophyseal hormone that promotes growth and anabolic protein metabolism.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>生长激素是腺垂体分泌、促进机体生长发育与蛋白质合成代谢的激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">生长激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">生长激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000534 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000534">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Prolactin: an adenohypophyseal hormone that promotes mammary development and lactation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>催乳素是腺垂体分泌、促进乳腺发育成熟与乳汁生成的激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">催乳素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">催乳素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000535 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000535">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Lipotropin: an adenohypophyseal peptide with lipolytic and fat-mobilizing actions.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促脂素是腺垂体分泌、具有促进脂肪分解与动员作用的多肽类激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">促脂素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促脂素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000536 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000536">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <ns6:TCM_TO_0000035 xml:lang="en">β-endorphin: an endogenous opioid peptide of pituitary origin involved in analgesia, stress and mood regulation.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>β-内啡肽是垂体分泌的内源性阿片肽，参与镇痛、应激与情绪调节。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Β-内啡肽</rdfs:label>
        <rdfs:label xml:lang="zh-cn">β-内啡肽</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000537 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000537">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000528"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000538"/>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000539"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Melanocyte-stimulating hormone: a peptide of the pars intermedia that stimulates melanin synthesis by melanocytes.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>黑素细胞刺激素是垂体中间部分泌、促进皮肤黑素细胞合成黑色素的多肽激素。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">黑素细胞刺激素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">黑素细胞刺激素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000538 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000538">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000209"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of ophthalmic nerve</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Pericardial cavity proper</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10056005</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Neurohypophysis: the posterior lobe of the pituitary, composed of hypothalamic neuronal terminals that store and release vasopressin and oxytocin.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>神经垂体是垂体的后叶部分，由下丘脑神经元轴突末梢构成，贮存并释放血管升压素与催产素。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8J35</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Pituitary gland</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>垂体</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/294069435</ns5:ICD11Reference>
        <ns4:FMAID>9895</ns4:FMAID>
        <rdfs:label xml:lang="en">Neurohypophysis</rdfs:label>
        <rdfs:label xml:lang="zh-cn">神经垂体</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10056005"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9895"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10056005"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000539 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000539">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000538"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Blood vessel part</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">Vasopressin (antidiuretic hormone): synthesized in the hypothalamus and released from the neurohypophysis, promoting water reabsorption in collecting ducts and causing vasoconstriction.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>血管升压素是下丘脑合成、神经垂体释放的抗利尿激素，促进肾集合管水重吸收并可收缩血管升高血压。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000036>抗利尿激素</ns6:TCM_TO_0000036>
        <ns4:FMAID>7082</ns4:FMAID>
        <rdfs:label xml:lang="en">Vasopressin</rdfs:label>
        <rdfs:label xml:lang="zh-cn">血管升压素</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7082"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/119206002"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000540 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000540">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000208"/>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000541"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Melatonin: an indoleamine secreted by the pineal gland that regulates circadian rhythms and the sleep-wake cycle.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>褪黑素是松果体分泌的胺类激素，调节昼夜节律与睡眠-觉醒周期。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">褪黑素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">褪黑素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000541 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000541">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000208"/>
        <ns6:TCM_TO_0000035>8-精索宫素为待核实的激素术语，疑为催产素（oxytocin，八肽）之误；催产素由下丘脑合成、神经垂体释放，促进子宫收缩与乳汁排出。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035 xml:lang="en">Term to be verified, presumably oxytocin (an octapeptide synthesized in the hypothalamus and released from the neurohypophysis, promoting uterine contraction and milk ejection).</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">8-精索宫素</rdfs:label>
        <rdfs:label xml:lang="zh-cn">8-精索宫素</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000543 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000543">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>胆汁来源于肝，由肝血化生，或由肝之余气凝聚而成。胆汁生成后， 进人胆腑，由胆腑浓缩并贮藏。贮藏于胆腑的胆汁，在肝气的疏泄作用下排泄而注人肠中， 以促进饮食水谷的 消化和吸收。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Storing and discharging bile</rdfs:label>
        <rdfs:label xml:lang="zh-cn">贮藏和排泄胆汁</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000544 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000544">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>胆主决断，是指胆具有判断事物、作出决定的作用。胆的这一机能对于防御和消除某些精神刺激的不良影响，以维待精气血津液的正常运行和代谢，确保脏腑之间的协调关系， 有着极为直要的作用。胆气豪壮之人，剧烈的精神刺激对其所造成的影响较小， 且恢复也较快；胆气虚怯之人， 在受到不良精神刺激时，则易于出现胆怯易惊、善恐、失眠、多梦等精 神悄志异常的病变。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">主决断</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主决断</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000545 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000545">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The gallbladder function of storing hepatic bile and concentrating it by absorbing water and electrolytes.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>储存浓缩胆汁是胆囊贮存肝胆汁并通过吸收水分与电解质将其浓缩的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Storing and concentrating bile</rdfs:label>
        <rdfs:label xml:lang="zh-cn">储存浓缩胆汁</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000546 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000546">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>三焦是诸气上下运行之通路。肾藏先天之精化生的元气， 自下而上运 行至胸中，布散于全身；胸中气海中的宗气， 自上而下到达肪下，以资先天元气，合为一身 之气，皆以三焦为通路。故《难经·六十六难》说：“三焦者， 原气之别使也。”《难经．三 十八难》指出 ： 三焦 “有原气之别焉，主持诸气。”</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">通行诸气</rdfs:label>
        <rdfs:label xml:lang="zh-cn">通行诸气</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000547 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000547">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of regulating biliary tract pressure through contraction and relaxation of biliary smooth muscle and the sphincter of Oddi.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>调节胆道压力是胆道平滑肌与奥迪括约肌舒缩活动调节胆道内压力、控制胆汁排放的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Regulating biliary tract pressure</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节胆道压力</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000468 -->

    
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000549 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000549">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The function of regulating effective circulating blood volume through neurohumoral mechanisms to maintain blood pressure and organ perfusion.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>调节循环血量是机体通过神经-体液机制调节有效循环血量、维持血压与器官灌注的功能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Regulating circulating blood volume</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调节循环血量</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000550 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000550">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Immune defense: the function of the immune system recognizing and eliminating invading pathogens.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>免疫防御是免疫系统识别并清除入侵病原微生物、保护机体的功能。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - Immune system</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>910012423</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/910012423</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - 免疫系统</ns6:hasICD11Name>
        <rdfs:label xml:lang="en">免疫防御</rdfs:label>
        <rdfs:label xml:lang="zh-cn">免疫防御</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000551 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000551">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Detoxification: the hepatic function of biotransforming toxins into inactive or excretable forms.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>解毒是肝脏通过生物转化作用将毒物代谢灭活或转化为可排泄形式的功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">解毒</rdfs:label>
        <rdfs:label xml:lang="zh-cn">解毒</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000552 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000552">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000457"/>
        <ns6:TCM_TO_0000035 xml:lang="en">Regeneration: the repair of tissue defects through proliferation of residual cells, restoring structure and function.</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>再生是组织损伤后通过残留细胞增殖以修复缺损、恢复结构与功能的过程。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">再生</rdfs:label>
        <rdfs:label xml:lang="zh-cn">再生</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000553 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000553">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <ns6:TCM_TO_0000035>三焦是 全身水液上下输布运行的通道。 全身水液的输布和排泄，是由 肺、脾、肾等脏的协同作用而完成的，但必须以三焦为通道，才能升降出入运行。如果三焦 水道不通利，则肺、脾、肾等脏的输布调节水液代谢的机能将难以实现，所以又把水液代谢 的协词平衡作用，称作 “三焦气化”。正如《类经·藏象类》所说：“上焦不治则水泛高原， 中焦不治则水留中院，下焦不治则水乱二便。三焦气治，则脉络通而水道利。”</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">运行水液</rdfs:label>
        <rdfs:label xml:lang="zh-cn">运行水液</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000554 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000554">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000065"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000451"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000480"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000468"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000562"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000563"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000564"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000565"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of serous coat of spleen</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Left kidney</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10945008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>脾是人体最大的淋巴器官，具有储血、造血、清除衰老红细胞和进行免疫应答的功能。
1.T细胞和B细胞定居的场所：脾是成熟淋巴细胞定居的场所，其中B细胞约占脾淋巴细胞总数的60%，T细胞约占40% 
2.免疫应答发生的场所：作为外周免疫器官，脾与淋巴结的主要区别在于：脾是对血源性抗体原生免疫应答的主要场所，而淋巴结主要对由引流淋巴液而来的抗原产生应答。
3.合成生物活性物质：脾可合成并分泌某些重要活性物质，如补体成分和细胞因子等。
4.过滤作用：体内约90%的循环血液经流脾，脾可以使血液得到净化。</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>脾是重要的淋巴器官，位于腹腔的左上方，呈扁椭圆形，暗红色、质软而脆，当局部受暴力打击易破裂出血。脾位于左季肋区胃底与膈之间，恰与第9-11肋相对，其长轴与第10肋一致。正常情况下，左肋弓下缘不能触及。脾分为内、外两面，上、下两缘，前、后两端。内面凹陷与胃底、左肾、左肾上腺、胰尾和结肠左曲为邻，称为脏面。脏面近中央处有一条沟，是神经、血管出入之处，称脾门。外面平滑而隆凸与膈相对，称为膈面。上缘前部有2-3个切迹，称脾切迹。脾肿大时，脾切迹仍存在可作为触诊的标志。在脾附近，胃脾韧带及大网膜中，常可见到暗红色，大小不等，数目不一的副脾。因脾功能亢进作脾切除时，应将副脾一并切除。脾属于网状皮系统，是人体最大的淋巴器官，其结构基本上与淋巴结相似，由被膜、小梁及淋巴组织构成。其与淋巴结不同的地方是没有淋巴窦，但其中具有大量血窦。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA7FU9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Spleen</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>脾</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/143777109</ns5:ICD11Reference>
        <ns4:FMAID>7205</ns4:FMAID>
        <rdfs:label xml:lang="en">Spleen</rdfs:label>
        <rdfs:label xml:lang="zh-cn">脾脏</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10945008"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7205"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10945008"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000555 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000555">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000554"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Posterior surface of ninth costal cartilage</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>120638006</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>白髓由密集的淋巴细胞构成，是机体发生特异性免疫的主要场所。当抗原侵入脾引起体液免疫应答时，白髓内淋巴小结会大量增多。</ns6:TCM_TO_0000035>
        <ns4:FMAID>8361</ns4:FMAID>
        <rdfs:label xml:lang="en">White pulp</rdfs:label>
        <rdfs:label xml:lang="zh-cn">白髓</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#120638006"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma8361"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000556 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000556">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000554"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Posterior surface of ninth costal cartilage</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>120638006</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>红髓主要由脾血窦和脾索组成，红髓内血流缓慢，使抗原与吞噬细胞的充分接触成为可能，是免疫细胞发生吞噬作用的主要场所。</ns6:TCM_TO_0000035>
        <ns4:FMAID>8361</ns4:FMAID>
        <rdfs:label xml:lang="en">Red pulp</rdfs:label>
        <rdfs:label xml:lang="zh-cn">红髓</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#120638006"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma8361"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000557 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000557">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000554"/>
        <ns6:TCM_TO_0000035>边缘区（MZ）位于红髓和白髓的交界处，此区淋巴细胞较白髓稀疏，以B细胞为主，但有较多的巨噬细胞（Mφ），是脾内捕获抗原、识别抗原和诱发免疫应答的重要部位。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">边缘区</rdfs:label>
        <rdfs:label xml:lang="zh-cn">边缘区</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000558 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000558">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001514"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of parotid lymph node</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10209003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>是淋巴管道的起始段，以膨大的盲端起始。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - - - - Lymphatic vessel of the face</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>2139888048</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/2139888048</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - - - - 面淋巴管</ns6:hasICD11Name>
        <ns5:ICD11ID_data>XA1EC8</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lymphatic vessel of the face</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>面淋巴管</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2139888048</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">毛细淋巴管</rdfs:label>
        <rdfs:label xml:lang="zh-cn">毛细淋巴管</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10209003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000559 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000559">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001514"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of parotid lymph node</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10209003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>由毛细淋巴管汇合而成，管壁与静脉相似，外形呈串珠状。</ns6:TCM_TO_0000035>
        <ns6:hasICD11EnglishName>- - - - - - Lymphatic vessel of the face</ns6:hasICD11EnglishName>
        <ns6:hasICD11ID>2139888048</ns6:hasICD11ID>
        <ns6:hasICD11Link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://id.who.int/icd/entity/2139888048</ns6:hasICD11Link>
        <ns6:hasICD11Name>- - - - - - 面淋巴管</ns6:hasICD11Name>
        <ns5:ICD11ID_data>XA1EC8</ns5:ICD11ID_data>
