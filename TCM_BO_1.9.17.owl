        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002888"/>
        <ns6:TCM_TO_0000035>阴道前庭为两小阴唇之间的菱形区域。前庭的前方有尿道口，后方有阴道口。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA1A52</ns5:ICD11ID_data>
