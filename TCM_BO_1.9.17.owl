        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000023"/>
        <ns6:TCM_TO_0000035>脑户穴位于人体的头部，后发际正中直上2.5寸，风府穴上1.5寸，枕外隆凸的上缘凹陷处。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA9738</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Brain</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>脑</ns5:ICD11NameZH>
