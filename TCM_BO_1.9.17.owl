        <ns5:ICD11ID_data>XA4U90</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Joints of the upper extremity</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>上肢关节</ns5:ICD11NameZH>
