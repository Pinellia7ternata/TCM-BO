        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000010"/>
        <ns6:TCM_TO_0000035>在腋窝顶点，腋动脉搏动处。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">极泉</rdfs:label>
        <rdfs:label xml:lang="zh-cn">极泉</rdfs:label>
    </owl:NamedIndividual>
    


