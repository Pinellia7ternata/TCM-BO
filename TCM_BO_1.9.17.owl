    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0002865 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002865">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002861"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003269"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000450"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000600"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000601"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>形态成人的子宫为前后略扁的倒置梨形，重50g，长7～8cm，宽4～5cm，厚2～3cm，宫腔容量5ml。子宫上部较宽为宫体，其上部隆突部分为宫底，两侧为宫角，子宫下部成圆柱形为宫颈。宫腔上宽下窄，子宫体与宫颈间最狭窄处为峡部，在非孕期长1cm，其上端形态上较为狭窄，成为解剖学内口；其下端为子宫内膜组织向宫颈黏膜转化的部位，故称为组织学内口。宫颈管长2.5～3cm，下端为宫颈外口。宫颈下端伸入阴道内的部分叫宫颈阴道部，阴道以上的部分叫宫颈阴道上部。未产妇的宫颈外口呈圆形，已产妇的宫颈外口受分娩影响而形成横裂。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA99N3</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Uterus</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>子宫</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/648738923</ns5:ICD11Reference>
        <ns4:FMAID>7564</ns4:FMAID>
        <rdfs:label xml:lang="en">Uterus</rdfs:label>
        <rdfs:label xml:lang="zh-cn">子宫</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7564"/>
    </owl:Class>
    


