        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001774"/>
        <rdfs:label xml:lang="zh-cn">west:体被系统</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000705 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000705">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000006"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000622"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003403"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000676"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000572"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000702"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000421>属大肠络肺、主传化糟粕、调节大肠气血、联络面口齿龈、循行主上肢外侧前缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于食指桡侧端，循上肢外侧前缘，上肩出髃骨之前廉，上出于柱骨之会上，下入缺盆络肺，下膈属大肠，行于上肢外侧前缘</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>手阳明大肠经为大肠之经脉，联络肺与面口，调节大肠传导功能，主治便秘、泄泻、牙痛、咽喉肿痛及上肢外侧前缘循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医上肢外侧前缘皮神经、桡动脉分支、大肠壁神经丛、面部三叉神经分支</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>大肠经实热、大肠经气滞（伴牙痛、便秘）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:手阳明大肠经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000706 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000706">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000014"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000644"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003404"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_900000000000000000068"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000578"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000708"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000707"/>
        <ns6:TCM_HAO_00000000000000000421>属胃络脾、主受纳腐熟、调节脾胃气血、联络面口唇齿、循行主头面/胸腹/下肢外侧前缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于鼻翼旁，上行至额角，下行循面入缺盆，下膈属胃络脾，循胸腹下行，沿下肢外侧前缘，止于第二趾外侧端，行于头面/胸腹/下肢外侧前缘</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>足阳明胃经为胃之经脉，多气多血，是脾胃营养全身的通道，主治胃痛、腹胀、口臭、头痛及下肢外侧前缘循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医头面部神经、胸腹部壁神经、下肢外侧前缘皮神经、胃壁神经丛</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>胃经实热、胃经虚寒、胃经气滞（伴头痛、胃痛）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:足阳明胃经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000707 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000707">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000546"/>
        <rdfs:label xml:lang="zh-cn">west:股后皮神经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000708 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000708">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002919"/>
        <rdfs:label xml:lang="zh-cn">west:面</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000709 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000709">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000017"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000644"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003404"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000578"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_900000000000000000068"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000710"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000711"/>
        <ns6:TCM_HAO_00000000000000000421>属脾络胃、主运化水谷、调节脾胃气血、联络四肢肌肉、循行主胸腹/下肢内侧前缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于足大趾内侧端，循下肢内侧前缘，上入腹，属脾络胃，上膈，连舌本散舌下，行于胸腹/下肢内侧前缘</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>足太阴脾经为脾之经脉，联络胃与舌，调节脾运化与气血生成，主治腹胀、便溏、肢体乏力、舌强不语及下肢内侧前缘循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医下肢内侧前缘皮神经、脾胰周围神经丛、舌神经、胃肠壁神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>脾经虚寒、脾经气滞（伴肢体乏力、腹胀）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:足太阴脾经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000710 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000710">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002469"/>
        <rdfs:label xml:lang="zh-cn">west:上肢肌肉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000711 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000711">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002514"/>
        <rdfs:label xml:lang="zh-cn">west:下肢肌肉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000712 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000712">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000010"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000644"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003405"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000577"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003445"/>
        <ns6:TCM_HAO_00000000000000000664 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000702"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000421>属心络小肠、主神志血脉、调节心脏气血、联络舌脉、循行主上肢内侧后缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于心中，出属心系，下膈络小肠，循上肢内侧后缘，止于小指桡侧端，行于上肢内侧后缘</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>手少阴心经为心之经脉，联络小肠与舌，调节心脏搏动与神志，主治心悸、失眠、健忘、舌疮及上肢内侧后缘循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医上肢内侧后缘皮神经、心脏窦房结神经、舌神经、小肠壁神经丛</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>心经火旺、心经虚寒、心经气滞（伴心悸、失眠）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:手少阴心经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000713 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000713">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000005"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000644"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003405"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003445"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000577"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000714"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000715"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000702"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000421>属小肠络心、主泌别清浊、调节小肠气血、联络目耳、循行主上肢外侧后缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于小指尺侧端，循上肢外侧后缘，上肩入缺盆，络心，下膈属小肠，行于上肢外侧后缘</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>手太阳小肠经为小肠之经脉，联络心与目耳，调节小肠泌别清浊功能，主治腹痛、泄泻、目赤、耳鸣及上肢外侧后缘循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医上肢外侧后缘皮神经、小肠壁神经丛、目系神经、耳周神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>小肠经实热、小肠经虚寒（伴腹痛、目赤）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:手太阳小肠经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000714 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000714">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000576"/>
        <rdfs:label xml:lang="zh-cn">west:视觉系统</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000715 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000715">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000661"/>
        <rdfs:label xml:lang="zh-cn">west:听觉系统</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000717 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000717">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000013"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000598"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000680"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000579"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000694"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000720"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000718"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000719"/>
        <ns6:TCM_HAO_00000000000000000421>属膀胱络肾、主水液代谢、调节膀胱气血、联络腰背目窍、循行主头项/腰背/下肢外侧后缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于目内眦，上额交巅，下项循腰背，沿下肢外侧后缘，止于小趾外侧端，行于头项/腰背/下肢外侧后缘，夹脊而行</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>足太阳膀胱经为膀胱之经脉，循行最长，夹脊联络五脏六腑背俞穴，调节水液代谢与腰背气血，主治小便不利、腰痛、头痛、目疾</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医腰背脊神经、下肢外侧后缘皮神经、膀胱壁神经丛、目内眦神经、肾脏周围神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>膀胱经实热、膀胱经虚寒、膀胱经气滞（伴腰痛、小便不利）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:足太阳膀胱经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000718 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000718">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000434"/>
        <rdfs:label xml:lang="zh-cn">west:腰脊神经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000719 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000719">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000507"/>
        <rdfs:label xml:lang="zh-cn">west:膀胱神经丛</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000720 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000720">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0002439"/>
        <rdfs:label xml:lang="zh-cn">west:腰部肌肉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000721 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000721">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000018"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000598"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000621"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000642"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000643"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000579"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000680"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000694"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000696"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000697"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000722"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000723"/>
        <ns6:TCM_HAO_00000000000000000421>属肾络膀胱、主藏精主水、调节肾脏气血、联络耳二阴、循行主胸腹/下肢内侧后缘病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于足小趾下，循下肢内侧后缘，上入腹，属肾络膀胱，上贯肝膈，入肺中，行于胸腹/下肢内侧后缘</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>足少阴肾经为肾之经脉，联络膀胱与耳、二阴，调节肾藏精、主水功能，主治腰膝酸软、头晕耳鸣、小便频数、阳痿宫寒</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医下肢内侧后缘皮神经、肾脏周围神经丛、耳神经、膀胱壁神经、生殖系统神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>肾经阴虚、肾经阳虚、肾经气滞（伴腰膝酸软、耳鸣）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:足少阴肾经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000722 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000722">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000535"/>
        <rdfs:label xml:lang="zh-cn">west:肾丛</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000723 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000723">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0000533"/>
        <rdfs:label xml:lang="zh-cn">west:阴部神经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000724 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000724">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000644"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003405"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000657"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003470"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000697"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000702"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000421>属心包络三焦、主代心受邪、调节心包气血、联络胸膈、循行主上肢内侧中线病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于胸中，出属心包络，下膈络三焦，循上肢内侧中线，止于中指端，行于上肢内侧中线</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>手厥阴心包经为心包之经脉，代心受邪，联络三焦，调节胸膈气机，主治心悸、胸闷、心痛、心烦及上肢内侧中线循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医上肢内侧中线皮神经、心包周围神经、胸膈神经、三焦相关代谢神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>心包经气滞、心包经痰阻（伴胸闷、心悸）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:手厥阴心包经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000725 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000725">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000007"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000726"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003470"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000657"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000689"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000697"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000702"/>
        <ns6:TCM_HAO_00000000000000000421>属三焦络心包、主三焦气化、调节三焦气血、联络目耳、循行主上肢外侧中线病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于无名指尺侧端，循上肢外侧中线，上肩入缺盆，络心包，下膈属三焦，行于上肢外侧中线</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>手少阳三焦经为三焦之经脉，联络心包与目耳，调节三焦水液与元气气化，主治腹胀、小便不利、耳鸣、目赤及上肢外侧中线循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医上肢外侧中线皮神经、胸腹部代谢神经、目耳周围神经、全身循环神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>三焦经气滞、三焦经气化失常（伴腹胀、小便不利）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:手少阳三焦经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000726 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000726">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003468"/>
        <rdfs:label xml:lang="zh-cn">tcm:脏腑</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000727 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000727">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000015"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000620"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003406"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000672"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003473"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000707"/>
        <ns6:TCM_HAO_00000000000000000421>属胆络肝、主疏泄情志、调节胆肝气血、联络目耳、循行主头侧/胸腹/下肢外侧中线病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于目外眦，上抵头角，下循胸胁，沿下肢外侧中线，止于第四趾外侧端，行于头侧/胸腹/下肢外侧中线</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>足少阳胆经为胆之经脉，联络肝与目耳，调节胆肝疏泄功能，主治口苦、胁痛、头晕、耳鸣、目赤及下肢外侧中线循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医头侧三叉神经、胸胁神经、下肢外侧中线皮神经、肝胆周围神经丛、目耳神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>胆经实热、胆经气滞、胆经虚寒（伴口苦、胁痛）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:足少阳胆经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000728 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000728">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000019"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000620"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003406"/>
        <ns6:TCM_HAO_00000000000000000660 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003473"/>
        <ns6:TCM_HAO_00000000000000000661 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000672"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000692"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000696"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000701"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000703"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000707"/>
        <ns6:TCM_HAO_00000000000000000421>属肝络胆、主藏血疏泄、调节肝气血、联络目舌、循行主胸腹/下肢内侧中线病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于足大趾背侧，循下肢内侧中线，上入腹，属肝络胆，上贯膈，布胁肋，连目系，行于胸腹/下肢内侧中线</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>足厥阴肝经为肝之经脉，联络胆与目，调节肝藏血、疏泄功能，主治胁痛、头晕、目涩、月经不调及下肢内侧中线循行痛</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医下肢内侧中线皮神经、肝胆周围神经丛、目系神经、生殖系统神经、胸胁神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>肝经火旺、肝经血虚、肝经气滞（伴胁痛、目涩）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:足厥阴肝经</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000729 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000729">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000716"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000680"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000730"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000733"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000752"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000757"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_900000000000000000068"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000696"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000720"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000760"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000761"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000718"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000758"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000759"/>
        <ns6:TCM_HAO_00000000000000000421>约束十二正经与奇经八脉、主固摄腰腹、调节带下、主治带下病/腰腹疼痛/肢体痿软</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于季胁，绕腰一周，状如束带，行于腰腹部，为唯一横行的奇经</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>带脉为“诸经之约束”，横行绕腰，将纵行的十二正经与奇经联系为整体，固摄腰腹气机，女子主调节带下，腰腹为带脉所主，带脉亏虚则腰腹无力、带下量多</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医腰腹部脊神经、腹斜肌周围神经、盆腔韧带周围神经、腰腹部皮下神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>带脉亏虚、带脉瘀阻、带脉气滞（伴带下量多、腰腹酸痛、肢体沉重）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:带脉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000730 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000730">
        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000022"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000726"/>
        <ns6:TCM_HAO_00000000000000000635 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0003476"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000696"/>
        <ns6:TCM_HAO_00000000000000000665 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000697"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000731"/>
        <ns6:TCM_HAO_00000000000000000688 rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000732"/>
        <ns6:TCM_HAO_00000000000000000421>总督一身阴经气血、主胞胎、调节脏腑阴液、联络胸腹官窍、主治妇科/前阴/胸腹病症</ns6:TCM_HAO_00000000000000000421>
        <ns6:TCM_HAO_00000000000000000658>起于胞中，下出会阴，沿前正中线上行，经腹、胸、颈，止于下唇内，行于人体前正中线上</ns6:TCM_HAO_00000000000000000658>
        <ns6:TCM_HAO_00000000000000000659>任脉为“阴脉之海”，总领任脉、冲脉、带脉等阴经，与女子胞胎密切相关，调节全身阴液与脏腑气血，主治月经不调、宫寒、腹痛、呃逆</ns6:TCM_HAO_00000000000000000659>
        <ns6:TCM_HAO_00000000000000000685>对应西医腹前正中线下神经、胸腹部壁神经、子宫卵巢周围神经、会阴神经</ns6:TCM_HAO_00000000000000000685>
        <ns6:TCM_HAO_00000000000000000690>任脉气滞、任脉虚寒、任脉瘀阻（伴月经不调、宫寒）</ns6:TCM_HAO_00000000000000000690>
        <rdfs:label xml:lang="zh-cn">tcm:任脉</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000731 -->

    <owl:NamedIndividual rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000731">
