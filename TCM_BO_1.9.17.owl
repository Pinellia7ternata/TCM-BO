    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_0001506 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001506">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_0001505"/>
