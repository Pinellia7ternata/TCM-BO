            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>血是运行于脉管中而富有营养的红色液态物质， 是构成人体和维持人体生命活动的基本物质之一。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA8EC5</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Blood</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>血液</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/2062516965</ns5:ICD11Reference>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Blood</rdfs:label>
        <rdfs:label xml:lang="zh-cn">血</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000435 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000435">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000574"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000629"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_TO_0000077"/>
                <owl:someValuesFrom rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000630"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>津液， 是机体一切正常水液的总称， 包括各脏腑组织器官的内在液体及其正常的分泌物， 如胃液、 肠液、 唾液、 关节液、 涕、 泪等， 是构成人体和维待人体生命活动的基本物质之一。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">津液</rdfs:label>
        <rdfs:label xml:lang="zh-cn">津液</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000438">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000482"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000483"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000456"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>肝藏血，是指肝脏具有贮藏血液、调节血最和防止出血的机能。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Storing blood (liver)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">主藏血</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000439 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000439">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>肝气的疏泄作用，调畅全身气机，使脏腑经络之气的运行通畅无阻。脏腑、经络、形体、官窍的机能活动，全赖于气的升降出人运动。由于肝气的生理特点是主升、主动，这对 于全身气机的疏通、畅达，是一个重要的因素。 因此，肝气的疏泄功能， 对各脏腑经络之气升降出入运动的协调平衡，起着重要的调节作用，对维持全身脏腑、经络、形体、官窍等机 能活动的有序进行，也是一个重要的条件。肝气的疏泄功能正常发挥，则气机调畅，气血和调，经络通利，脏腑、形体、官窍等的机能活动也稳定有序。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">调畅全身气机</rdfs:label>
        <rdfs:label xml:lang="zh-cn">调畅全身气机</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000440 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000440">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000424"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Entire peripheral nerve of upper limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Left middle thyroid vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000445"/>
        <ns6:SNOMEDID>181008003</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The body region of the upper limb (shoulder, arm, forearm and hand).</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>上肢部位是人体上肢（肩、臂、前臂、手）所在的身体部位。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA4BA8</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Upper extremity</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>上肢</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/986233688</ns5:ICD11Reference>
        <ns4:FMAID>50825</ns4:FMAID>
        <rdfs:label xml:lang="en">Entire peripheral nerve of upper limb</rdfs:label>
        <rdfs:label xml:lang="zh-cn">上肢部位</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#181008003"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma50825"/>
        <skos:exactMatch rdf:resource="http://snomed.info/id/181008003"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000441 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000441">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000461"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Portion of blood</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>119206002</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>血液的运行和津液的输布代谢，有赖于气机的调畅。</ns6:TCM_TO_0000035>
        <ns4:FMAID>9670</ns4:FMAID>
        <rdfs:label xml:lang="en">Promoting blood circulation and distribution</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进血液运行与输布</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#119206002"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma9670"/>
    
        <ns6:TCM_TO_0000036 xml:lang="zh-cn">促进血液的运行与输布</ns6:TCM_TO_0000036>
        <ns6:TCM_TO_0000036 xml:lang="en">Promoting blood circulation and distribution</ns6:TCM_TO_0000036>
        <rdfs:comment xml:lang="zh-cn">1.9.15 经三专家复核与PI裁决，由 TCM_HAO_00000000000000000628（促进血液的运行与输布）合并入本类，公理与映射注解已迁移。</rdfs:comment>
        <ns6:TCM_TO_0000035 xml:lang="en">Promoting blood circulation and distribution: the propelling action of qi on blood movement in TCM (qi commands blood; when qi moves, blood moves).</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>促进血液的运行与输布是气对血液运行的推动作用（中医：气为血之帅，气行则血行）。</ns6:TCM_TO_0000035>
        <rdfs:comment xml:lang="zh-cn">1.9.15b 一致性修复：机建重复类 TCM_HAO_00000000000000000628 并入时带入的父类“推动与调控作用”(TCM_HAO_00000000000000000623) 与本类经等价链（主血/主脉→主血脉）所在分支互斥，予以移除；本类保留专家审定父类“主疏泄”。</rdfs:comment>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000442 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000442">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000464"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000623"/>
        <ns6:TCM_TO_0000035>血液的运行和津液的输布代谢，有赖于气机的调畅。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">促进津液的运行与输布</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进津液的运行与输布</rdfs:label>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000443 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000443">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000486"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Structure of serous coat of spleen</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>10945008</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>脾气以升为健，胃气以降为和。脾胃的运化机能，体现在脾胃之气的升降相因，平衡协调，与肝气的疏泄功能有密切关系。因为肝气疏泄，调畅气机，有助于脾胃之气的升降，从而促进脾胃的运化功能。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">Promoting the transportive-transformative function of spleen and stomach (TCM)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进脾胃（中医）的运化功能</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#10945008"/>
        <skos:closeMatch rdf:resource="http://snomed.info/id/10945008"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000444 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000444">
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000478"/>
        <owl:equivalentClass rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000479"/>
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Jejunum</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>11105007</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035>食物的消化吸收要借助胆汁的分泌和排泄，因为胆汁参与饮食物消化和吸收的“精汁”。胆汁乃肝之余气所化，其分泌和排泄受肝气疏泄功能的影响。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7207</ns4:FMAID>
        <rdfs:label xml:lang="en">Promoting bile secretion and excretion</rdfs:label>
        <rdfs:label xml:lang="zh-cn">促进胆汁的分泌排泄</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ihtsdo.org/snomedct/anatomy#11105007"/>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma7207"/>
    </owl:Class>
    


    <!-- http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000445 -->

    <owl:Class rdf:about="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000445">
        <rdfs:subClassOf rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000424"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/SNOMEDName_data"/>
                <owl:hasValue>Skeletal muscle structure of lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Dorsal lingual vein</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:SNOMEDID>102292000</ns6:SNOMEDID>
        <ns6:TCM_TO_0000035 xml:lang="en">The body region of the lower limb (hip, thigh, leg and foot).</ns6:TCM_TO_0000035>
        <ns6:TCM_TO_0000035>下肢部位是人体下肢（髋、大腿、小腿、足）所在的身体部位。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA45A6</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Lower extremity</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>下肢</ns5:ICD11NameZH>
