        <rdf:type rdf:resource="http://OntoTCM.org.cn/ontologies/TCM_HAO_00000000000000000011"/>
        <ns6:TCM_TO_0000035>天池穴位于人体的胸部，当第４肋间隙，乳头外1寸，前正中线旁开5寸。</ns6:TCM_TO_0000035>
        <rdfs:label xml:lang="en">天池</rdfs:label>
        <rdfs:label xml:lang="zh-cn">天池</rdfs:label>
    </owl:NamedIndividual>
    


