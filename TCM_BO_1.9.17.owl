        <ns5:ICD11NameZH>肠淋巴干</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/440775758</ns5:ICD11Reference>
        <rdfs:label xml:lang="en">淋巴干</rdfs:label>
        <rdfs:label xml:lang="zh-cn">淋巴干</rdfs:label>
