            <owl:Restriction>
                <owl:onProperty rdf:resource="http://OntoTCM.org.cn/ontologies/hasFMAName"/>
                <owl:hasValue>Hair of left lower limb</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns6:TCM_TO_0000035>同解剖学，即固有鼻腔。古代中医文献无此名称，一般称为鼻中或鼻内，亦称鼻房。《澹轩方》：“......蜜和绵包纳鼻房。”鼻腔内之鼻甲粘膜，中医合称为肌膜。</ns6:TCM_TO_0000035>
        <ns5:ICD11ID_data>XA43C9</ns5:ICD11ID_data>
        <ns5:ICD11NameEN>Nasal cavity</ns5:ICD11NameEN>
        <ns5:ICD11NameZH>鼻腔</ns5:ICD11NameZH>
        <ns5:ICD11Reference>http://id.who.int/icd/entity/208474189</ns5:ICD11Reference>
        <ns4:FMAID>54247</ns4:FMAID>
        <rdfs:label xml:lang="en">Nasal cavity</rdfs:label>
        <rdfs:label xml:lang="zh-cn">鼻腔</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.org/sig/ont/fma/fma54247"/>
    </owl:Class>
    


