        <ns6:TCM_TO_0000035>腹结穴位于人体的下腹部，大横穴下l.3寸，距前正中线４寸。</ns6:TCM_TO_0000035>
        <ns4:FMAID>7496</ns4:FMAID>
        <rdfs:label xml:lang="en">Fujie (SP14 acupoint)</rdfs:label>
        <rdfs:label xml:lang="zh-cn">腹结</rdfs:label>
