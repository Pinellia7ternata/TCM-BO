        <ns5:ICD11Reference>http://id.who.int/icd/entity/1493524587</ns5:ICD11Reference>
        <ns4:FMAID>14561</ns4:FMAID>
        <rdfs:label xml:lang="en">Gastric branches</rdfs:label>
        <rdfs:label xml:lang="zh-cn">胃支</rdfs:label>
